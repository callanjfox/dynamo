+    #[test]
+    fn peer_hbm_pulls_what_the_source_holds_only_in_its_device_kv() {
+        // Source G2 holds 0 and 1; its device KV also holds 2 and 3.
+        let f = Fixture::new(&[0, 1], &[]);
+        let keys = f.keys(&[0, 1, 2, 3]);
+        // Off: only the G2 prefix is pulled (partial).
+        {
+            let (mut adapter, mut restore) = (f.adapter(), RestoreRounds::default());
+            f.registry.lock().unwrap().note_device_events(f.source, &[device_stored(&[2, 3])]);
+            assert!(!f.registry.lock().unwrap().device_holds(f.source, 2));
+            let mut target = f.target.lock();
+            assert!(adapter.stage_at(&mut target, f.owner, f.source, &mut restore, &keys, 0.0));
+            assert!(adapter.advance(&mut target, 10.0));
+            assert_eq!(target.take_kvcr_origin(&keys), 2);
+        }
+        // On: the whole prefix, the device blocks unpinned at the source.
+        let f = Fixture::new(&[0, 1], &[]);
+        f.registry.lock().unwrap().set_peer_hbm(true);
+        f.registry.lock().unwrap().note_device_events(f.source, &[device_stored(&[2, 3])]);
+        assert!(f.registry.lock().unwrap().device_holds(f.source, 3));
+        let (mut adapter, mut restore) = (f.adapter(), RestoreRounds::default());
+        let mut target = f.target.lock();
+        assert!(adapter.stage_at(&mut target, f.owner, f.source, &mut restore, &keys, 0.0));
+        assert_eq!(f.source_pins(&keys), vec![1, 1, 0, 0]);
+        assert!(adapter.advance(&mut target, 20.0));
+        assert_eq!(target.take_kvcr_origin(&keys), 4);
+        assert_eq!(f.source_pins(&keys), vec![0, 0, 0, 0]);
+        assert_eq!(f.stats().peer_hbm_blocks, 2);
+        // A device eviction is seen.
+        f.registry.lock().unwrap().note_device_events(
+            f.source,
+            &[crate::engine::KvEvent {
+                event_id: 1,
+                dp_rank: 0,
+                data: crate::engine::KvEventData::Removed { block_hashes: vec![3] },
+                tier: crate::engine::KvEventTier::Device,
+            }],
+        );
+        assert!(!f.registry.lock().unwrap().device_holds(f.source, 3));
+    }
