+    #[cfg(test)]
+    pub(crate) fn set_peer_hbm(&mut self, on: bool) {
+        self.config.peer_hbm = on;
+    }
+
+    /// Whether pulls may read a peer's device KV (`KvcrConfig::peer_hbm`).
+    pub(crate) fn peer_hbm(&self) -> bool {
+        self.config.peer_hbm
+    }
+
+    /// Track `rank`'s device-resident blocks from its device-tier KV events (with `peer_hbm`).
+    pub(crate) fn note_device_events(&mut self, rank: KvHintSource, events: &[crate::engine::KvEvent]) {
+        if !self.config.peer_hbm {
+            return;
+        }
+        let set = self.g1_resident.entry(rank).or_default();
+        for event in events {
+            if event.tier != crate::engine::KvEventTier::Device {
+                continue;
+            }
+            match &event.data {
+                crate::engine::KvEventData::Stored(stored) => {
+                    set.extend(stored.blocks.iter().map(|b| b.block_hash));
+                }
+                crate::engine::KvEventData::Removed { block_hashes } => {
+                    for hash in block_hashes {
+                        set.remove(hash);
+                    }
+                }
+            }
+        }
+    }
+
+    /// Whether `rank`'s device KV holds the block with sequence hash `hash` (with `peer_hbm`).
+    pub(crate) fn device_holds(&self, rank: KvHintSource, hash: u64) -> bool {
+        self.config.peer_hbm && self.g1_resident.get(&rank).is_some_and(|set| set.contains(&hash))
+    }
+
+    /// Note a pull's blocks read from a peer's device KV.
+    pub(crate) fn note_peer_hbm(&mut self, blocks: usize) {
+        self.stats.peer_hbm_blocks += blocks as u64;
+    }
+
     pub(crate) fn source(&self, rank: KvHintSource) -> Option<HostTierHandle> {
         self.ranks.get(&rank).map(|rank| rank.g2.clone())
     }
