+    #[test]
+    fn retained_copies_are_evicted_after_ordinary_ones_and_expired_first() {
+        let mut pool = VllmBlockPool::new(4);
+        let kept = cache_copy(&mut pool, 1);
+        pool.release(kept);
+        let expired = cache_copy(&mut pool, 2);
+        pool.release(expired);
+        for hash in [3, 4] {
+            let copy = cache_copy(&mut pool, hash);
+            pool.release(copy);
+        }
+        // 1 is kept until t=100, 2 only until t=5; 3 and 4 are ordinary LRU.
+        assert_eq!(pool.protect(&[kept], 100.0, 0.0), 1);
+        assert_eq!(pool.protect(&[expired], 5.0, 0.0), 1);
+        pool.assert_lru_consistent();
+        pool.set_now_ms(10.0);
+        // Expired protection first, then the ordinary LRU, the live one last.
+        let pressure = reserve(&mut pool, &[], 4);
+        assert_eq!(pressure.removed, vec![2, 3, 4, 1]);
+        assert_eq!(pool.take_retain_broken(), 1);
+        pool.cancel(pressure.reservation);
+        pool.assert_lru_consistent();
+    }
