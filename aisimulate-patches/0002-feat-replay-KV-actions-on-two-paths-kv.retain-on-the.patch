+    /// `kv.release_source`: drop the resident, unpinned `keys` (a move's source
+    /// copy, once its pull landed). Keys still pinned by another load or pull,
+    /// or no longer resident, stay as they are. Publishes their removal like an
+    /// eviction. Returns the blocks that were dropped.
+    pub(crate) fn drop_resident(&mut self, keys: &[HostBlockKey], now_ms: f64) -> Vec<HostBlockKey> {
+        let mut dropped = Vec::new();
+        for key in keys {
+            let droppable = self
+                .entries
+                .get(key)
+                .is_some_and(|entry| entry.state == EntryState::Resident && entry.load_pins == 0);
+            if !droppable {
+                continue;
+            }
+            let mut entry = self.entries.remove(key).expect("checked entry disappeared");
+            self.lru.remove(&mut entry.lru_slot);
+            self.forget_owner(*key);
+            self.observe(HostOffloadObservation {
+                request_id: Uuid::nil(),
+                event: HostOffloadObservationData::Evicted {
+                    at_ms: now_ms,
+                    block: *key,
+                },
+            });
+            dropped.push(*key);
+        }
+        if self.meta_retained() {
+            for key in &dropped {
+                self.meta.remove(key);
+            }
+            if !dropped.is_empty() {
+                self.publish(|| KvEventData::Removed {
+                    block_hashes: dropped.iter().map(|key| key.sequence_hash()).collect(),
+                });
+            }
+        }
+        dropped
+    }
