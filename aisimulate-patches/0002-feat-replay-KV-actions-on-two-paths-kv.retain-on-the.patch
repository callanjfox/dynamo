+        assert!(matches!(tier.lookup(key(1)), Lookup::Hit));
+        assert!(matches!(tier.lookup(key(2)), Lookup::Miss));
+        // Off (path B mode), plain LRU again: the oldest block goes.
+        state.lock().unwrap().set_enabled(false);
+        let StoreOutcome::Prepared { transfer_id, .. } =
+            tier.reserve_external(0, newest, &[key(5)], None, 4.0)
+        else {
+            panic!()
+        };
+        tier.complete_external(transfer_id);
+        assert!(matches!(tier.lookup(key(1)), Lookup::Miss));
+    }
+
+    #[test]
+    fn release_source_drops_only_resident_unpinned_blocks() {
+        let mut tier = private(4, 0.0, 0.0);
+        let owner = Uuid::from_u128(1);
+        let (a, b, c) = (key(1), key(2), key(3));
+        for (k, t) in [(a, 0.0), (b, 1.0)] {
+            let StoreOutcome::Prepared { transfer_id, .. } =
+                tier.reserve_external(0, owner, &[k], None, t)
+            else {
+                panic!()
+            };
+            tier.complete_external(transfer_id);
+        }
+        tier.pin_external(&[b]);
+        // `b` is pinned by a pull still reading it and `c` is not resident: only `a` drops.
+        assert_eq!(tier.drop_resident(&[a, b, c], 2.0), vec![a]);
+        assert!(matches!(tier.lookup(a), Lookup::Miss));
+        assert!(matches!(tier.lookup(b), Lookup::Hit));
+        tier.unpin_external(&[b]);
+        assert_eq!(tier.lru.order(), [b]);
+    }
