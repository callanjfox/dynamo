+    /// `kv.retain`: keep the inactive `copies` out of ordinary LRU eviction until
+    /// `until_ms`. Copies another request still references are left as they are.
+    /// Returns how many copies entered protection.
+    pub(crate) fn protect(&mut self, copies: &[BlockCopyId], until_ms: f64, now_ms: f64) -> usize {
+        assert!(
+            self.belady.is_none(),
+            "kv.retain does not combine with the Belady eviction policy"
+        );
+        self.retain.get_or_insert_with(Box::default).now_ms = now_ms;
+        let mut protected = 0;
+        for &id in copies {
+            if !self.copies.contains_key(id) || !self.is_inactive(id) {
+                continue;
+            }
+            if self.in_retain_list(id) {
+                self.retain.as_deref_mut().unwrap().set_expiry(id, until_ms);
+                continue;
+            }
+            if !self.is_linked_inactive(id) {
+                continue;
+            }
+            self.unlink_inactive(id);
+            self.retain.as_deref_mut().unwrap().set_expiry(id, until_ms);
+            self.link_inactive_tail(id, true);
+            protected += 1;
+        }
+        protected
+    }
+
+    /// Protected copies evicted before their TTL ran out, since the last call.
+    pub(crate) fn take_retain_broken(&mut self) -> u64 {
+        self.retain
+            .as_deref_mut()
+            .map_or(0, |retain| std::mem::take(&mut retain.broken))
+    }
+
+    fn in_retain_list(&self, id: BlockCopyId) -> bool {
+        self.retain
+            .as_deref()
+            .is_some_and(|retain| retain.until_ms.contains_key(&id))
+    }
+
+    /// Whether `id` is linked into the ordinary inactive LRU.
+    fn is_linked_inactive(&self, id: BlockCopyId) -> bool {
+        let CopyState::Cached {
+            inactive_prev, ..
