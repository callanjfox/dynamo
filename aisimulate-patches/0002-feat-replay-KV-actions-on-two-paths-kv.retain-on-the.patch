+    /// Victims by retention value: blocks of no known session first (as LRU),
+    /// then the sessions worth least per block. `None` when value retention is
+    /// not active, so the caller uses the LRU.
+    fn value_victims(
+        &self,
+        needed: usize,
+        now_ms: f64,
+        mut eligible: impl FnMut(HostBlockKey) -> bool,
+    ) -> Option<Vec<HostBlockKey>> {
+        let state = self.retain.as_ref()?.lock().unwrap();
+        if !state.active(self.last_evict_ms, now_ms) {
+            return None;
+        }
+        let owner_of = &self.owner_of;
+        let mut victims = self
+            .lru
+            .victims(needed, |key| !owner_of.contains_key(&key) && eligible(key));
+        if victims.len() == needed {
+            return Some(victims);
+        }
+        let mut owners: Vec<(f64, u64)> = self
+            .by_owner
+            .iter()
+            .map(|(owner, keys)| (state.value(*owner, now_ms) / keys.len() as f64, *owner))
+            .collect();
+        owners.sort_by(|a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
+        'owners: for (_, owner) in owners {
+            let mut keys: Vec<_> = self.by_owner[&owner].iter().copied().collect();
+            keys.sort_unstable();
+            for key in keys {
+                if eligible(key) {
+                    victims.push(key);
+                    if victims.len() == needed {
+                        break 'owners;
+                    }
+                }
+            }
+        }
+        Some(victims)
+    }
