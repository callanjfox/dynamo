diff --git a/crates/core/src/engine/kv_retain.rs b/crates/core/src/engine/kv_retain.rs
new file mode 100644
index 000000000..b7ae63002
--- /dev/null
+++ b/crates/core/src/engine/kv_retain.rs
@@ -0,0 +1,169 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Retention by value (`kv.retain` with a value) for one pool's G2 tiers.
+//!
+//! The router attaches a value to each request (path A); this state turns it
+//! into a per-session value at eviction time. A session's value is its class
+//! weight, discounted by how long until its next turn (`H / (H + wait)`,
+//! H = 300 s) while it is idle, its full weight while a turn is in flight, and
+//! nothing once the session ended. G2 tiers evict the blocks of the session
+//! worth least per block first. Path B (`kv.retain` mode) turns it off and on.
+
+use std::sync::{Arc, Mutex};
+
+use rustc_hash::FxHashMap;
+use uuid::Uuid;
+
+use crate::replay::KvRetainValue;
+
+pub(crate) type SharedRetainState = Arc<Mutex<RetainState>>;
+
+/// The discount horizon, as `web/sim.js` `planHorizonS`.
+const HORIZON_MS: f64 = 300_000.0;
+
+#[derive(Debug, Clone, Copy)]
+struct SessionValue {
+    weight: f64,
+    /// When the next turn is expected; `None` while a turn is in flight.
+    return_at_ms: Option<f64>,
+    ended: bool,
+}
+
+#[derive(Debug)]
+pub(crate) struct RetainState {
+    /// Path B mode: retention by value on (the default once configured) or off.
+    enabled: bool,
+    requests: FxHashMap<Uuid, KvRetainValue>,
+    sessions: FxHashMap<u64, SessionValue>,
+    short_window_ms: Option<u64>,
+}
+
+impl Default for RetainState {
+    fn default() -> Self {
+        Self {
+            enabled: true,
+            requests: FxHashMap::default(),
+            sessions: FxHashMap::default(),
+            short_window_ms: None,
+        }
+    }
+}
+
+impl RetainState {
+    pub(crate) fn shared() -> SharedRetainState {
+        Arc::new(Mutex::new(Self::default()))
+    }
+
+    /// Path A: a booked request's value. Its session has a turn in flight.
+    pub(crate) fn note_request(&mut self, request: Uuid, value: KvRetainValue) {
+        self.short_window_ms = value.short_window_ms;
+        self.requests.insert(request, value);
+        let weight = f64::from(value.weight_milli) / 1000.0;
+        let session = self.sessions.entry(value.session).or_insert(SessionValue {
+            weight,
+            return_at_ms: None,
+            ended: false,
+        });
+        session.weight = weight;
+        session.return_at_ms = None;
+        session.ended = false;
+    }
+
+    /// A request finished at `now_ms`: its session is idle until its next turn,
+    /// or ended.
+    pub(crate) fn note_finished(&mut self, request: Uuid, now_ms: f64) {
+        let Some(value) = self.requests.remove(&request) else {
+            return;
+        };
+        let Some(session) = self.sessions.get_mut(&value.session) else {
+            return;
+        };
+        if value.session_final {
+            session.ended = true;
+        } else {
+            session.return_at_ms = Some(
+                value
+                    .think_ms
+                    .map_or(f64::INFINITY, |think| now_ms + think as f64),
+            );
+        }
+    }
+
+    /// Path B mode update.
+    pub(crate) fn set_enabled(&mut self, enabled: bool) {
+        self.enabled = enabled;
+    }
+
+    /// Whether G2 evicts by value: configured, enabled, and (retain-short) the
+    /// tier evicted within the window.
+    pub(crate) fn active(&self, last_evict_ms: f64, now_ms: f64) -> bool {
+        self.enabled
+            && !self.sessions.is_empty()
+            && self
+                .short_window_ms
+                .is_none_or(|window| now_ms - last_evict_ms < window as f64)
+    }
+
+    pub(crate) fn session_of(&self, request: Uuid) -> Option<u64> {
+        self.requests.get(&request).map(|value| value.session)
+    }
+
+    /// What losing all of `session`'s KV costs now, in weighted misses.
+    pub(crate) fn value(&self, session: u64, now_ms: f64) -> f64 {
+        let Some(session) = self.sessions.get(&session) else {
+            return 0.0;
+        };
+        if session.ended {
+            return 0.0;
+        }
+        match session.return_at_ms {
+            None => session.weight,
+            Some(at) if at.is_infinite() => 0.0,
+            Some(at) => session.weight * HORIZON_MS / (HORIZON_MS + (at - now_ms).max(0.0)),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn value(session: u64, think_ms: Option<u64>, session_final: bool) -> KvRetainValue {
+        KvRetainValue {
+            session,
+            weight_milli: 2000,
+            think_ms,
+            session_final,
+            short_window_ms: None,
+        }
+    }
+
+    #[test]
+    fn a_session_is_worth_its_weight_in_flight_less_while_idle_nothing_when_ended() {
+        let mut state = RetainState::default();
+        let (a, b) = (Uuid::from_u128(1), Uuid::from_u128(2));
+        state.note_request(a, value(7, Some(300_000), false));
+        assert_eq!(state.value(7, 0.0), 2.0);
+        state.note_finished(a, 0.0);
+        // Back in 300 s: half its weight now, the full weight when it is due.
+        assert!((state.value(7, 0.0) - 1.0).abs() < 1e-9);
+        assert_eq!(state.value(7, 300_000.0), 2.0);
+        state.note_request(b, value(7, None, true));
+        state.note_finished(b, 400_000.0);
+        assert_eq!(state.value(7, 400_000.0), 0.0);
+        assert_eq!(state.value(99, 0.0), 0.0);
+    }
+
+    #[test]
+    fn retain_short_is_active_only_after_a_recent_eviction() {
+        let mut state = RetainState::default();
+        let mut short = value(1, None, false);
+        short.short_window_ms = Some(600_000);
+        state.note_request(Uuid::from_u128(1), short);
+        assert!(state.active(0.0, 100_000.0));
+        assert!(!state.active(0.0, 700_000.0));
+        state.set_enabled(false);
+        assert!(!state.active(0.0, 100_000.0));
+    }
+}
