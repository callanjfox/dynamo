+    /// `engine.dequeue`: take `request_id` back from rank `scheduler_id` if it still waits
+    /// there (no pass has started it, its prefill has not completed, it is not being tokenized)
+    /// and a copy of it was kept. Cancels it on the rank and keeps the copy for the policy's
+    /// new placement. Returns whether it was taken back.
+    fn dequeue(&mut self, scheduler_id: usize, request_id: Uuid) -> anyhow::Result<bool> {
+        let Some(state) = self.requests.get(&request_id) else {
+            return Ok(false);
+        };
+        if state.scheduler_id() != Some(scheduler_id)
+            || state.prefill_completed
+            || state.retained.is_none()
+        {
+            return Ok(false);
+        }
+        if self
+            .tokenization
+            .as_ref()
+            .is_some_and(|t| t.contains(request_id))
+        {
+            return Ok(false);
+        }
+        if self
+            .engine
+            .request_has_committed_pass(scheduler_id, request_id)?
+        {
+            return Ok(false);
+        }
+        let effects = self.engine.apply_command(
+            scheduler_id,
+            Command::CancelRequest {
+                request_id,
+                discard_pending_output: true,
+            },
+            self.now_ms,
+        )?;
+        self.apply_engine_observations(effects.engine_events, KvIngestBoundary::SchedulerCommand)?;
+        let request = self
+            .requests
+            .get_mut(&request_id)
+            .and_then(|state| state.take_for_requeue())
+            .ok_or_else(|| anyhow::anyhow!("dequeued request {request_id} lost its copy"))?;
+        self.requeued.insert(request_id, request);
         Ok(true)
     }
 
