+    /// Hand a dequeued request back: it is placed again from the kept copy.
+    pub(crate) fn take_for_requeue(&mut self) -> Option<DirectRequest> {
+        if self.phase != AggRequestPhase::Running || self.prefill_completed {
+            return None;
+        }
