+#[cfg(test)]
+mod dequeue_tests {
+    use super::*;
+    use crate::engine::{EngineConfig, TimingModelConfig};
+    use crate::replay::components::NoReplayMetadata;
+    use crate::replay::core::{KvAction, KvActionMessage, KvActionRequest, KvActionResult};
+    use crate::replay::engine::{ReplayEngineConfig, ReplayEngineFactory};
+    use crate::replay::loadgen::ReplayRequestPayload;
+    use crate::replay::{NoEngineEvents, PlacementEffects, WorkerStage};
+    use std::collections::VecDeque;
+
+    const LONG: Uuid = Uuid::from_u128(1);
+    const WAITING: Uuid = Uuid::from_u128(2);
+
+    /// Puts every request on rank 0, then at `ask_ms` asks rank 0 to hand `WAITING` back and
+    /// places it on rank 1.
+    struct DequeueToIdle {
+        ask_ms: f64,
+        asked: bool,
+        outbox: Vec<KvActionMessage>,
+        results: Vec<KvActionResult>,
+        requeued: Vec<Uuid>,
+    }
+
+    fn placement(request_id: Uuid, scheduler_id: usize) -> Placement {
+        Placement {
+            request_id,
+            scheduler_id,
+            reported_overlap_tokens: 0,
+            cache_sample: None,
+            kv_hints: None,
+            placement_replica_id: None,
+        }
+    }
+
+    impl PlacementPolicy<ReplayRequestPayload> for DequeueToIdle {
+        type Metadata = NoReplayMetadata;
+        type Observation = ();
+
+        fn place(
+            &mut self,
+            request: &ReplayRequestPayload,
+            _metadata: Self::Metadata,
+            _session_id: Option<String>,
+            _now_ms: f64,
+        ) -> anyhow::Result<PlacementEffects> {
+            let id = request.metadata().uuid.expect("test ids");
+            Ok(PlacementEffects {
+                decision: PlacementDecision::Immediate(placement(id, 0)),
+                released: Vec::new(),
+            })
+        }
+        fn observe(&mut self, _o: (), _now_ms: f64) -> anyhow::Result<Vec<Placement>> {
+            Ok(Vec::new())
+        }
+        fn advance_clock(&mut self, now_ms: f64) -> anyhow::Result<Vec<Placement>> {
+            if !self.asked && now_ms >= self.ask_ms {
+                self.asked = true;
+                self.outbox.push(KvActionMessage {
+                    scheduler_id: 0,
+                    message_id: 1,
+                    actions: vec![KvActionRequest {
+                        action_id: 1,
+                        action: KvAction::Dequeue { request_id: WAITING },
+                    }],
+                });
+            }
+            Ok(Vec::new())
+        }
+        fn next_wakeup_ms(&self) -> Option<f64> {
+            (!self.asked).then_some(self.ask_ms)
+        }
+        fn take_kv_actions(&mut self) -> Vec<KvActionMessage> {
+            std::mem::take(&mut self.outbox)
+        }
+        fn kv_action_results(&mut self, results: Vec<KvActionResult>, _now_ms: f64) -> anyhow::Result<()> {
+            self.results.extend(results);
+            Ok(())
+        }
+        fn retains_dispatched(&self) -> bool {
+            true
+        }
+        fn requeued(&mut self, request_id: Uuid, _now_ms: f64) -> anyhow::Result<Vec<Placement>> {
+            self.requeued.push(request_id);
+            Ok(vec![placement(request_id, 1)])
+        }
+        fn cancel_pending(&mut self, _request_id: Uuid) -> bool {
+            false
+        }
+        fn request_terminal(&mut self, _id: Uuid, _now_ms: f64) -> anyhow::Result<Vec<Placement>> {
+            Ok(Vec::new())
+        }
+        fn prefill_completed(&mut self, _id: Uuid, _now_ms: f64) -> anyhow::Result<Vec<Placement>> {
+            Ok(Vec::new())
+        }
+        fn pending_count(&self) -> usize {
+            0
+        }
+        fn worker_ready(&mut self, _w: WorkerTopology, _now_ms: f64) -> anyhow::Result<Vec<Placement>> {
+            Ok(Vec::new())
+        }
+        fn worker_draining(&mut self, _w: WorkerTopology, _now_ms: f64) -> anyhow::Result<Vec<Placement>> {
+            Ok(Vec::new())
+        }
+        fn worker_removed(&mut self, _w: WorkerTopology, _now_ms: f64) -> anyhow::Result<Vec<Placement>> {
+            Ok(Vec::new())
+        }
+        fn topology_settled(&mut self, _now_ms: f64) -> anyhow::Result<Vec<Placement>> {
+            Ok(Vec::new())
+        }
+    }
+
+    fn request(uuid: Uuid, at_ms: f64, tokens: Vec<u32>, out: usize) -> DirectRequest {
+        DirectRequest {
+            tokens,
+            max_output_tokens: out,
+            uuid: Some(uuid),
+            arrival_timestamp_ms: Some(at_ms),
+            ..DirectRequest::default()
+        }
+    }
+
+    fn run(ask_ms: f64) -> TraceCollector {
+        let config = ReplayEngineConfig {
+            rank: EngineConfig {
+                num_gpu_blocks: 64,
+                block_size: 4,
+                max_num_seqs: 1,
+                max_num_batched_tokens: 64,
+                enable_prefix_caching: true,
+                timing_model: TimingModelConfig::Fixed {
+                    prefill_ms: 1.0,
+                    decode_ms: 1.0,
+                },
+                ..EngineConfig::default()
+            },
+            ..ReplayEngineConfig::default()
+        };
+        let factory = ReplayEngineFactory::new()
+            .role_factory(&config, WorkerStage::Aggregated, false)
+            .unwrap();
+        let admission = AdmissionQueue::new_requests(
+            VecDeque::from([
+                request(LONG, 0.0, vec![1, 2, 3, 4], 100),
+                request(WAITING, 1.0, vec![5, 6, 7, 8], 2),
+            ]),
+            ReplayMode::Trace,
+        );
+        let runtime = AggRuntimeImpl::<DequeueToIdle, NoEngineEvents, ()>::new_composed(
+            factory,
+            admission,
+            2,
+            None,
+            move |_dp_size, _topology| {
+                Ok(DequeueToIdle {
+                    ask_ms,
+                    asked: false,
+                    outbox: Vec::new(),
+                    results: Vec::new(),
+                    requeued: Vec::new(),
+                })
+            },
+        )
+        .unwrap()
+        .with_per_request_records(true);
+        runtime.run().unwrap().0
+    }
+
+    #[test]
+    fn a_waiting_request_is_handed_back_and_runs_on_another_rank() {
+        let report = run(5.0).finish();
+        assert_eq!(report.request_counts.completed_requests, 2);
+        let waiting = report
+            .per_request
+            .iter()
+            .find(|r| r.uuid == WAITING.to_string())
+            .unwrap();
+        assert_eq!(waiting.decode_worker_idx, Some(1));
+        assert_eq!(waiting.terminal_status, ReplayTerminalStatus::Completed);
+        let long = report
+            .per_request
+            .iter()
+            .find(|r| r.uuid == LONG.to_string())
+            .unwrap();
+        // It ran beside the long request instead of waiting ~100 decode steps behind it.
+        assert!(waiting.first_admit_ms.unwrap() < 10.0, "{:?}", waiting.first_admit_ms);
+        assert!(long.first_admit_ms.unwrap() < 1.0);
+    }
+
+    #[test]
+    fn a_running_request_is_not_handed_back() {
+        // At 200 ms the waiting request has long since run on rank 0.
+        let report = run(200.0).finish();
+        assert_eq!(report.request_counts.completed_requests, 2);
+        let waiting = report
+            .per_request
+            .iter()
+            .find(|r| r.uuid == WAITING.to_string())
+            .unwrap();
+        assert_eq!(waiting.decode_worker_idx, Some(0));
+    }
+}
