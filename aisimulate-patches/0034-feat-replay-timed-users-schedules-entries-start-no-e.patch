+
+/// A timed schedule entry's start floor, skip time and holds, in ms.
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct EntryTiming {
+    pub at_ms: f64,
+    pub until_ms: Option<f64>,
+    pub holds: Vec<(u32, f64)>,
 }
 
