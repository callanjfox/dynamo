From 1b9828299984f679419a28e140193fc57a1e139f Mon Sep 17 00:00:00 2001
From: callan <callanf@nvidia.com>
Date: Tue, 17 Nov 2026 22:49:43 +0000
Subject: [PATCH 34/38] feat(replay): timed users schedules: entries start no
 earlier than at_s, are skipped at or after until_s (the user has left), and
 hold nodes until absolute times (correlated idle returns); schema
 dynosim.users.schedule.timed (an untimed schedule with these fields is
 refused); a user whose plan ends with a stay that ends is not out of entries;
 unit tests

---
 crates/core/src/replay/loadgen/driver.rs |  32 +++-
 crates/core/src/replay/loadgen/users.rs  | 206 ++++++++++++++++++++++-
 2 files changed, 227 insertions(+), 11 deletions(-)

diff --git a/crates/core/src/replay/loadgen/driver.rs b/crates/core/src/replay/loadgen/driver.rs
index 02ad4670c..5354a00f3 100644
--- a/crates/core/src/replay/loadgen/driver.rs
+++ b/crates/core/src/replay/loadgen/driver.rs
@@ -3766,22 +3766,38 @@ impl WorkloadDriver {
 
     /// Starts user `user`'s next schedule entry at `start_ms` (its roots become ready then), unless
     /// the user has none left or the start is at or past the horizon. An empty template is skipped.
-    fn users_start_next(&mut self, user: usize, start_ms: f64) -> Result<()> {
+    /// In a timed run an entry starts no earlier than its `at_s`, is skipped when it would start at
+    /// or after its `until_s`, and its held nodes are not ready before their times.
+    fn users_start_next(&mut self, user: usize, mut start_ms: f64) -> Result<()> {
         let users = self.users.as_mut().expect("users run");
         if start_ms >= users.horizon_ms() {
             return Ok(());
         }
         let corpus = Arc::clone(&users.spec.corpus);
-        let (position, template_index) = loop {
+        let (position, template_index, holds) = loop {
             let position = users.next_entry[user];
             let Some(&template_index) = users.spec.plans[user].get(position) else {
-                users.users_out_of_entries += 1;
-                tracing::warn!(user, position, "users run: a user ran out of schedule entries");
+                if !users.spec.left_for_good(user) {
+                    users.users_out_of_entries += 1;
+                    tracing::warn!(user, position, "users run: a user ran out of schedule entries");
+                }
                 return Ok(());
             };
             users.next_entry[user] += 1;
+            let mut holds = Vec::new();
+            if let Some(timing) = users.spec.entry_timing(user, position) {
+                let start = start_ms.max(timing.at_ms);
+                if timing.until_ms.is_some_and(|until| start >= until) {
+                    continue;
+                }
+                if start >= users.horizon_ms() {
+                    return Ok(());
+                }
+                start_ms = start;
+                holds.clone_from(&timing.holds);
+            }
             if !corpus.templates[template_index].nodes.is_empty() {
-                break (position, template_index);
+                break (position, template_index, holds);
             }
         };
         let template = &corpus.templates[template_index];
@@ -3858,6 +3874,12 @@ impl WorkloadDriver {
         state.lanes[user].active_play = Some(play_index);
         users.copies.push(copy);
         state.activate_play(play_index, start_ms, &mut self.sessions, &mut self.ready_sessions);
+        // Held nodes are not roots (validated), so they are still blocked: their dependencies
+        // release them no earlier than the hold.
+        for (node, until_ms) in holds {
+            let index = node_offset + node as usize;
+            state.ready_after_ms[index] = state.ready_after_ms[index].max(until_ms);
+        }
         Ok(())
     }
 
