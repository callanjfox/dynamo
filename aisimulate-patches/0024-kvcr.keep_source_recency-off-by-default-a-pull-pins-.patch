 crates/core/src/engine/host_offload/tier.rs   | 95 ++++++++++++++++++-
 crates/core/src/engine/kvcr.rs                |  5 +
 crates/core/src/engine/scheduler/vllm/core.rs | 16 ++++
 .../src/engine/scheduler/vllm/host_offload.rs |  5 +
 crates/core/src/engine/scheduler/vllm/kvcr.rs | 35 +++++--
 6 files changed, 155 insertions(+), 8 deletions(-)

