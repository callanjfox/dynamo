+    /// [`Self::pin_external`] for a KVCR source read that keeps recency (`kvcr.keep_source_recency`):
+    /// the blocks stay at their place in the LRU; victim selection skips them while pinned.
+    pub(crate) fn pin_external_keep_recency(&mut self, keys: &[HostBlockKey]) {
+        for key in keys {
+            let entry = self
+                .entries
+                .get_mut(key)
+                .expect("pin requires a resident G2 entry");
+            debug_assert_eq!(entry.state, EntryState::Resident);
+            entry.load_pins = entry
+                .load_pins
+                .checked_add(1)
+                .expect("host pin count overflow");
+        }
+    }
+
+    /// Release [`Self::pin_external_keep_recency`]. A block another load took out of the LRU
+    /// meanwhile re-enters it as the newest once its last pin goes, as that load's release would.
+    pub(crate) fn unpin_external_keep_recency(&mut self, keys: &[HostBlockKey]) {
+        for key in keys {
+            let Some(entry) = self.entries.get_mut(key) else {
+                continue;
+            };
+            entry.load_pins = entry
+                .load_pins
+                .checked_sub(1)
+                .expect("host pin count underflow");
+            if entry.load_pins == 0 && entry.state == EntryState::Resident && entry.lru_slot.is_none() {
+                self.lru.touch(&mut entry.lru_slot, *key);
+            }
+        }
+    }
+
