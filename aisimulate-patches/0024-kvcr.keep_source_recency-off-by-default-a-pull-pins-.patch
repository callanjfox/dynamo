+    #[test]
+    fn source_pin_that_keeps_recency_survives_eviction_and_keeps_its_place() {
+        // `kvcr.keep_source_recency`: as vLLM's KVCR source read, the pin neither evicts the block
+        // nor moves it; it stays the least recently used once unpinned.
+        let mut tier = private(2, 0.0, 0.0);
+        let owner = Uuid::from_u128(1);
+        let (a, b, c, d) = (key(1), key(2), key(3), key(4));
+        for (k, t) in [(a, 0.0), (b, 1.0)] {
+            let StoreOutcome::Prepared { transfer_id, .. } =
+                tier.reserve_external(0, owner, &[k], None, t)
+            else {
+                panic!()
+            };
+            tier.complete_external(transfer_id);
+        }
+        tier.pin_external_keep_recency(&[a]);
+        assert_eq!(tier.lru.order(), [a, b]);
+        // `a` is LRU but pinned, so `c` evicts `b`, through a store and through a planned reservation.
+        let StoreOutcome::Prepared { transfer_id, .. } =
+            tier.reserve_external(0, owner, &[c], None, 2.0)
+        else {
+            panic!()
+        };
+        tier.complete_external(transfer_id);
+        assert!(matches!(tier.lookup(a), Lookup::Hit));
+        assert!(matches!(tier.lookup(b), Lookup::Miss));
+        let mut plan = tier.plan_external(&[d], 3.0);
+        assert!(tier.plan_reserve(&mut plan, d));
+        assert_eq!(plan.victims, [c]);
+        tier.unpin_external_keep_recency(&[a]);
+        assert_eq!(tier.pins(a), 0);
+        // Unpinned, `a` is where it was: the oldest.
+        assert_eq!(tier.lru.order(), [a, c]);
+    }
+
