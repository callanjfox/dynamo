+    /// The KVCR probe's occupancy split: blocks pending a store or landing, resident but pinned
+    /// (loads, pulls), and resident and evictable.
+    pub(crate) fn probe_occupancy(&self) -> [usize; 3] {
+        let mut out = [0; 3];
+        for entry in self.entries.values() {
+            let i = match entry.state {
+                EntryState::Resident if entry.load_pins == 0 && entry.lru_slot.is_some() => 2,
+                EntryState::Resident => 1,
+                _ => 0,
+            };
+            out[i] += 1;
+        }
+        out
+    }
