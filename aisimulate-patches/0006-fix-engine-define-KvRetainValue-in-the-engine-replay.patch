diff --git a/crates/core/src/engine/kv_retain.rs b/crates/core/src/engine/kv_retain.rs
index b7ae63002..27d28676f 100644
--- a/crates/core/src/engine/kv_retain.rs
+++ b/crates/core/src/engine/kv_retain.rs
@@ -15,7 +15,26 @@ use std::sync::{Arc, Mutex};
 use rustc_hash::FxHashMap;
 use uuid::Uuid;
 
-use crate::replay::KvRetainValue;
+/// Retention by value (`kv.retain` priority): G2 evicts the blocks whose loss
+/// costs least per block first. A session's value is its class weight,
+/// discounted by how long until its next turn (`H / (H + wait)`, H = 300 s) and
+/// spread over its blocks; an ended session is worth nothing.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct KvRetainValue {
+    /// The session's key (a hash of its session id); its blocks share one value.
+    pub session: u64,
+    /// The class weight, in thousandths.
+    pub weight_milli: u32,
+    /// The client's expected think time to the next turn, from when this request
+    /// finishes; `None` when unknown.
+    pub think_ms: Option<u64>,
+    /// This request ends its session.
+    pub session_final: bool,
+    /// Retain by value only while this rank's G2 evicted within this window
+    /// (retain-short); `None` always.
+    pub short_window_ms: Option<u64>,
+}
+
 
 pub(crate) type SharedRetainState = Arc<Mutex<RetainState>>;
 
