+    /// Under `class_scheduling`, the index at which a request of class `rank` joins `queue`:
+    /// behind every live request of its class or a higher one (`front_of_class` false), or ahead
+    /// of every live request of its own class (`front_of_class` true, for a preempted request).
+    /// The queue stays in (class rank, arrival) order, so admission still takes the head.
+    fn class_insert_index(
+        &self,
+        queue: &VecDeque<Uuid>,
+        rank: usize,
+        front_of_class: bool,
+        include_connector_waiting: bool,
+    ) -> usize {
+        queue
+            .iter()
+            .position(|queued| {
+                let is_live = self.waiting_members.contains(queued)
+                    || (include_connector_waiting && self.connector_waiting_members.contains(queued));
+                is_live
+                    && self.requests.get(queued).is_some_and(|request| {
+                        if front_of_class {
+                            request.class_rank >= rank
+                        } else {
+                            request.class_rank > rank
+                        }
+                    })
+            })
+            .unwrap_or(queue.len())
+    }
+
+    fn class_rank_of(&self, uuid: Uuid) -> usize {
+        self.requests
+            .get(&uuid)
+            .map_or(0, |request| request.class_rank)
+    }
