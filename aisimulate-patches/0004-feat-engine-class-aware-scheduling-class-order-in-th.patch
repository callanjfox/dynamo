+/// Class-aware scheduling for the vLLM-style engine (the JS model's `classQueue` and
+/// `preemptLower`/`batchPreempt`). Requests carry a policy class; `order` ranks the classes from
+/// highest to lowest, and a request whose class is missing or unknown ranks below them all.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ClassSchedulingConfig {
+    /// Policy classes from highest to lowest priority, e.g. `["priority", "standard", "batch"]`.
+    pub order: Vec<String>,
+    /// When set, a waiting request ranked at or above this index that cannot be admitted for
+    /// lack of KV or sequence slots preempts running requests ranked below it (lowest class
+    /// first, newest first). `Some(0)` is `preemptLower` (priority takes room from the rest);
+    /// `Some(1)` is `batchPreempt` (priority and standard take room from batch).
+    #[serde(default)]
+    pub preempt_max_rank: Option<usize>,
+}
+
+impl ClassSchedulingConfig {
+    /// Rank of a policy class: its index in `order`, or `order.len()` when absent or unknown.
+    pub fn rank_of(&self, class: Option<&str>) -> usize {
+        class
+            .and_then(|c| self.order.iter().position(|o| o == c))
+            .unwrap_or(self.order.len())
+    }
+}
+
