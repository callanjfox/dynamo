+mod class_scheduling {
+    use super::*;
+    use crate::engine::ClassSchedulingConfig;
+
+    fn args(preempt_max_rank: Option<usize>, classes: bool) -> MockEngineArgs {
+        MockEngineArgs::builder()
+            .block_size(4)
+            .num_gpu_blocks(64)
+            .max_num_batched_tokens(Some(64))
+            .max_num_seqs(Some(1))
+            .enable_chunked_prefill(true)
+            .enable_prefix_caching(false)
+            .speedup_ratio(0.0)
+            .class_scheduling(classes.then(|| ClassSchedulingConfig {
+                order: vec!["priority".into(), "standard".into(), "batch".into()],
+                preempt_max_rank,
+            }))
+            .build()
+            .unwrap()
+    }
+
+    fn submit(core: &mut VllmCore, id: u128, class: &str) -> Uuid {
+        let uuid = Uuid::from_u128(id);
+        core.receive(DirectRequest {
+            tokens: vec![id as u32; 8],
+            max_output_tokens: 32,
+            uuid: Some(uuid),
+            policy_class: Some(class.to_string()),
+            ..Default::default()
+        });
+        uuid
+    }
+
+    fn running(core: &VllmCore, uuid: Uuid) -> bool {
+        core.state
+            .requests
+            .get(&uuid)
+            .is_some_and(|r| r.status == RequestStatus::Running)
+    }
+
+    #[test]
+    fn waiting_queue_is_served_in_class_order_then_arrival() {
+        let mut core = VllmCore::new(args(None, true));
+        let batch = submit(&mut core, 1, "batch");
+        let standard = submit(&mut core, 2, "standard");
+        let priority = submit(&mut core, 3, "priority");
+        let unknown = submit(&mut core, 4, "other");
+        let mut collector = crate::engine::trace::TraceCollector::default();
+        core.execute_pass(&mut collector, 0.0);
+        assert!(running(&core, priority));
+        assert!(!running(&core, standard) && !running(&core, batch) && !running(&core, unknown));
+        let order: Vec<Uuid> = core
+            .state
+            .waiting
+            .iter()
+            .copied()
+            .filter(|u| core.state.requests.get(u).is_some_and(|r| r.status != RequestStatus::Running))
+            .collect();
+        assert_eq!(order, vec![standard, batch, unknown]);
+    }
+
+    #[test]
+    fn without_class_scheduling_the_queue_stays_first_come_first_served() {
+        let mut core = VllmCore::new(args(None, false));
+        let batch = submit(&mut core, 1, "batch");
+        let priority = submit(&mut core, 3, "priority");
+        let mut collector = crate::engine::trace::TraceCollector::default();
+        core.execute_pass(&mut collector, 0.0);
+        assert!(running(&core, batch));
+        assert!(!running(&core, priority));
+    }
+
+    #[test]
+    fn priority_preempts_a_running_lower_class_when_there_is_no_room() {
+        let mut core = VllmCore::new(args(Some(0), true));
+        let batch = submit(&mut core, 1, "batch");
+        let mut collector = crate::engine::trace::TraceCollector::default();
+        let pass = core.execute_pass(&mut collector, 0.0);
+        assert!(running(&core, batch));
+        let priority = submit(&mut core, 2, "priority");
+        core.execute_pass(&mut collector, pass.end_ms);
+        assert!(running(&core, priority));
+        assert!(!running(&core, batch));
+        assert_eq!(core.state.requests[&batch].num_preemptions, 1);
+        assert_eq!(core.class_preemptions_total, 1);
+    }
+
+    #[test]
+    fn standard_does_not_preempt_under_preempt_lower() {
+        let mut core = VllmCore::new(args(Some(0), true));
+        let batch = submit(&mut core, 1, "batch");
+        let mut collector = crate::engine::trace::TraceCollector::default();
+        let pass = core.execute_pass(&mut collector, 0.0);
+        let standard = submit(&mut core, 2, "standard");
+        core.execute_pass(&mut collector, pass.end_ms);
+        assert!(running(&core, batch));
+        assert!(!running(&core, standard));
+        assert_eq!(core.class_preemptions_total, 0);
+    }
+
+    #[test]
+    fn batch_preempt_lets_standard_take_room_from_batch_only() {
+        let mut core = VllmCore::new(args(Some(1), true));
+        let batch = submit(&mut core, 1, "batch");
+        let mut collector = crate::engine::trace::TraceCollector::default();
+        let pass = core.execute_pass(&mut collector, 0.0);
+        let standard = submit(&mut core, 2, "standard");
+        let pass = core.execute_pass(&mut collector, pass.end_ms);
+        assert!(running(&core, standard));
+        assert!(!running(&core, batch));
+        // A priority request cannot take room from standard under rank 1: both rank at or above it.
+        let priority = submit(&mut core, 3, "priority");
+        core.execute_pass(&mut collector, pass.end_ms);
+        assert!(running(&core, standard));
+        assert!(!running(&core, priority));
+    }
+}
