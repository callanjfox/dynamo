+    /// The protected classes' slack this pass, as the JS model's `prioStepCap`: for each
+    /// protected request that is decoding, 90% of its ITL target times the tokens it has made,
+    /// less the time since its first token. From it, how many lower-class decodes may run
+    /// (`yield_decodes`, oldest first) and how many lower-class prefill tokens fit (256-token
+    /// steps), using the timing model with prefill and decode added.
+    fn set_class_step_limits(&mut self, now_ms: f64) -> anyhow::Result<()> {
+        self.pass_low_prefill_budget = None;
+        self.pass_low_decode_allow = None;
+        let Some(cfg) = self.args.class_scheduling.clone() else {
+            return Ok(());
+        };
+        let Some(protect) = cfg.protect_max_rank else {
+            return Ok(());
+        };
+        let mut cap = f64::INFINITY;
+        let (mut n_hi, mut ctx_hi) = (0usize, 0usize);
+        let mut low_decodes: Vec<usize> = Vec::new();
+        for uuid in self.state.running.iter() {
+            let Some(request) = self.state.requests.get(uuid) else {
+                continue;
+            };
+            if !self.state.running_members.contains(uuid) || request.status != RequestStatus::Running {
+                continue;
+            }
+            let decoding = request.num_computed_tokens >= request.sequence.num_input_tokens();
+            if !decoding {
+                continue;
+            }
+            if request.class_rank <= protect {
+                n_hi += 1;
+                ctx_hi += request.sequence.len();
+                if let (Some(itl), Some(first)) = (cfg.itl_target_ms_of(request.class_rank), request.first_token_ms) {
+                    let generated = request.sequence.generated_tokens().max(1) as f64;
+                    cap = cap.min(0.9 * itl * generated - (now_ms - first));
+                }
+            } else {
+                low_decodes.push(request.sequence.len());
+            }
+        }
+        if !cap.is_finite() {
+            return Ok(());
+        }
+        let decode_ms = |n: usize, ctx: usize| -> anyhow::Result<f64> {
+            if n == 0 {
+                return Ok(0.0);
+            }
+            let ms = self.args.perf_model.predict_decode_time(n, ctx, ctx / n, self.decode_kv_context_bound(ctx))?;
+            Ok(scale_decode_time(ms, &self.args)?.as_secs_f64() * 1e3)
+        };
+        let lim = cap.max(decode_ms(n_hi, ctx_hi)?);
+        let (mut n_dec, mut ctx_dec) = (n_hi, ctx_hi);
+        let mut decode_allow = None;
+        if cfg.yield_decodes {
+            let mut allow = 0;
+            for ctx in &low_decodes {
+                if decode_ms(n_dec + 1, ctx_dec + ctx)? > lim {
+                    break;
+                }
+                allow += 1;
+                n_dec += 1;
+                ctx_dec += ctx;
+            }
+            decode_allow = Some(allow);
+        } else {
+            for ctx in &low_decodes {
+                n_dec += 1;
+                ctx_dec += ctx;
+            }
+        }
+        let base = decode_ms(n_dec, ctx_dec)?;
+        let max_tokens = self.args.max_num_batched_tokens.unwrap_or(8192);
+        let mut budget = 0usize;
+        while budget + 256 <= max_tokens {
+            let ms = self.args.perf_model.predict_prefill_time(1, budget + 256, 0)?;
+            if scale_prefill_time(ms, &self.args)?.as_secs_f64() * 1e3 + base > lim {
+                break;
+            }
+            budget += 256;
+        }
+        self.pass_low_decode_allow = decode_allow;
+        self.pass_low_prefill_budget = Some(budget);
+        Ok(())
+    }
