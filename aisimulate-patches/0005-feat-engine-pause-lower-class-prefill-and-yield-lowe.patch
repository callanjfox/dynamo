@@ -154,6 +154,19 @@ pub struct ClassSchedulingConfig {
     /// `Some(1)` is `batchPreempt` (priority and standard take room from batch).
     #[serde(default)]
     pub preempt_max_rank: Option<usize>,
+    /// Inter-token latency target per class in milliseconds, in `order` (missing or null: none).
+    #[serde(default)]
+    pub itl_target_ms: Vec<Option<f64>>,
+    /// Classes ranked at or above this are protected each pass: lower classes' prefill is cut
