+    /// A priority request decoding with no slack left (its first token long ago), then a batch
+    /// request with a long prompt: under protect_max_rank 0 the batch prefill is paused.
+    fn behind_late_priority(protect: Option<usize>, yield_decodes: bool) -> (VllmCore, Uuid) {
+        let mut core = VllmCore::new(protect_args(protect, yield_decodes));
+        let _priority = submit(&mut core, 1, "priority");
+        let mut collector = crate::engine::trace::TraceCollector::default();
+        let mut t = 0.0;
+        for _ in 0..3 {
+            t = core.execute_pass(&mut collector, t).end_ms;
+        }
+        let batch = Uuid::from_u128(2);
+        core.receive(DirectRequest {
+            tokens: vec![2; 1024],
+            max_output_tokens: 8,
+            uuid: Some(batch),
+            policy_class: Some("batch".to_string()),
+            ..Default::default()
+        });
+        core.execute_pass(&mut collector, t + 100_000.0);
+        (core, batch)
+    }
+
+    #[test]
+    fn pause_prefill_holds_lower_class_prefill_when_priority_has_no_slack() {
+        let (core, batch) = behind_late_priority(Some(0), false);
+        assert_eq!(core.state.requests[&batch].num_computed_tokens, 0);
+        assert!(core.prefill_pauses_total >= 1);
+    }
+
+    #[test]
+    fn without_protection_lower_class_prefill_runs() {
+        let (core, batch) = behind_late_priority(None, false);
+        assert!(core.state.requests[&batch].num_computed_tokens > 0);
+        assert_eq!(core.prefill_pauses_total, 0);
+    }
+
+    #[test]
+    fn yield_decodes_leaves_batch_decodes_out_when_priority_has_no_slack() {
+        for (yield_decodes, expect_yield) in [(true, true), (false, false)] {
+            let mut core = VllmCore::new(protect_args(Some(1), yield_decodes));
+            let batch = submit(&mut core, 1, "batch");
+            let _priority = submit(&mut core, 2, "priority");
+            let mut collector = crate::engine::trace::TraceCollector::default();
+            let mut t = 0.0;
+            for _ in 0..3 {
+                t = core.execute_pass(&mut collector, t).end_ms;
+            }
+            let before = core.state.requests[&batch].sequence.generated_tokens();
+            core.execute_pass(&mut collector, t + 100_000.0);
+            let after = core.state.requests[&batch].sequence.generated_tokens();
+            assert_eq!(core.decode_yields_total >= 1, expect_yield, "yield_decodes={yield_decodes}");
+            assert_eq!(after == before, expect_yield, "yield_decodes={yield_decodes}");
+        }
+    }
+
