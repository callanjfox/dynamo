+    #[serde(default)]
+    pub protect_max_rank: Option<usize>,
+    /// With `protect_max_rank`: also leave lower-class decodes (newest first) out of a pass that
+    /// would still exceed that slack.
+    #[serde(default)]
+    pub yield_decodes: bool,
 }
 
 impl ClassSchedulingConfig {
@@ -163,6 +176,11 @@ impl ClassSchedulingConfig {
             .and_then(|c| self.order.iter().position(|o| o == c))
             .unwrap_or(self.order.len())
     }
+
+    /// The ITL target of a class rank, in milliseconds.
+    pub fn itl_target_ms_of(&self, rank: usize) -> Option<f64> {
+        self.itl_target_ms.get(rank).copied().flatten()
+    }
