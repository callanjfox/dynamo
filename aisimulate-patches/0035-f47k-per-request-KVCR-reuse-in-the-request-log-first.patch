From: callan <callanf@nvidia.com>
Date: Wed, 18 Nov 2026 11:38:55 +0000
Subject: [PATCH 35/38] f47k: per-request KVCR reuse in the request log
 (first_admission_kvcr_reused_input_tokens)

---
 crates/core/src/engine/host_offload/tier.rs   | 26 ++++++----
 crates/core/src/engine/mod.rs                 | 13 +++++
 crates/core/src/engine/protocol.rs            |  3 ++
 crates/core/src/engine/scheduler/vllm/core.rs | 11 ++++-
 .../src/engine/scheduler/vllm/host_offload.rs | 48 +++++++++++++++----
 crates/core/src/replay/components/engine.rs   |  1 +
 crates/core/src/replay/report.rs              | 14 ++++++
 crates/core/tests/agentx_qualification.rs     | 10 ++++
 crates/core/tests/kvcr_replay.rs              | 10 ++--
 crates/tests/public-api/src/lib.rs            |  2 +
 10 files changed, 115 insertions(+), 23 deletions(-)

diff --git a/crates/core/src/engine/host_offload/tier.rs b/crates/core/src/engine/host_offload/tier.rs
index 1bc37466e..428a011b9 100644
--- a/crates/core/src/engine/host_offload/tier.rs
+++ b/crates/core/src/engine/host_offload/tier.rs
@@ -1015,16 +1015,24 @@ impl HostTier {
 
     /// Count the `keys` a KVCR peer fetch filled and clear their mark, so each
     /// pulled block counts once, at its first load.
+    #[cfg(test)]
     pub(crate) fn take_kvcr_origin(&mut self, keys: &[HostBlockKey]) -> usize {
-        let mut count = 0;
-        for key in keys {
-            if let Some(entry) = self.entries.get_mut(key)
-                && std::mem::take(&mut entry.kvcr_origin)
-            {
-                count += 1;
-            }
-        }
-        count
+        self.take_kvcr_origin_flags(keys)
+            .into_iter()
+            .filter(|pulled| *pulled)
+            .count()
+    }
+
+    /// For each of `keys`, whether a KVCR peer fetch filled it; clears the
+    /// marks, so each pulled block counts once, at its first load.
+    pub(crate) fn take_kvcr_origin_flags(&mut self, keys: &[HostBlockKey]) -> Vec<bool> {
+        keys.iter()
+            .map(|key| {
+                self.entries
+                    .get_mut(key)
+                    .is_some_and(|entry| std::mem::take(&mut entry.kvcr_origin))
+            })
+            .collect()
     }
 
     /// Roll back an unsubmitted reservation.
diff --git a/crates/core/src/engine/mod.rs b/crates/core/src/engine/mod.rs
index 8dbc36f92..7de3fa4d2 100644
--- a/crates/core/src/engine/mod.rs
+++ b/crates/core/src/engine/mod.rs
@@ -26,6 +26,19 @@ pub fn class_preemption_enabled() -> bool {
 pub fn set_class_preemption_enabled(on: bool) {
     CLASS_PREEMPTION.store(on, std::sync::atomic::Ordering::Relaxed);
 }
+
+static KVCR_REUSE_FIELD: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Whether request records carry `first_admission_kvcr_reused_input_tokens` (off by default, so
+/// request logs are unchanged; dynosim's replay turns it on with `DYNAMO_REPLAY_KVCR_FIELD=1`);
+/// process-wide.
+pub fn kvcr_reuse_field() -> bool {
+    KVCR_REUSE_FIELD.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+pub fn set_kvcr_reuse_field(on: bool) {
+    KVCR_REUSE_FIELD.store(on, std::sync::atomic::Ordering::Relaxed);
+}
 pub(crate) mod kvcr;
 mod launch;
 mod offload_lru;
