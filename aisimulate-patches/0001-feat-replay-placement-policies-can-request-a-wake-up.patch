@@ -158,6 +158,13 @@ pub trait PlacementPolicy<Request> {
     fn advance_clock(&mut self, _now_ms: f64) -> Result<Vec<Placement>> {
         Ok(Vec::new())
     }
+    /// The earliest replay time at which this policy has work to release without any other
+    /// event, such as a dispatch gate's hold deadline or a client retry. The replay visits it
+    /// and calls [`Self::advance_clock`] there, so a hold in an otherwise idle cluster still
+    /// wakes. `None` (the default) when every pending request waits on an engine event.
+    fn next_wakeup_ms(&self) -> Option<f64> {
+        None
+    }
     fn cancel_pending(&mut self, request_id: Uuid) -> bool;
     /// Discard all request state, including tentative placement state when
     /// cancellation precedes engine dispatch.
