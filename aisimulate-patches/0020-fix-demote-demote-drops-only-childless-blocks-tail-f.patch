 use super::grouped::{GroupedKvPool, GroupedLease};
 use super::state_cache_manager::{StateCacheManager, StateRequest};
 use crate::engine::belady::BeladyOracle;
+
+/// Cached prefix chains of one rank's G1, from its KV events.
+#[derive(Debug, Default)]
+pub(crate) struct CachedChains {
+    parent_of: rustc_hash::FxHashMap<SequenceHash, SequenceHash>,
+    children: rustc_hash::FxHashMap<SequenceHash, u32>,
+}
 pub(crate) use crate::engine::cache::vllm_block_pool::SourceReuseDependency;
 use crate::engine::cache::vllm_block_pool::{
     BlockCopyId, BlockReservation, CacheKey, ReserveOutcome, VllmBlockPool,
@@ -381,6 +388,10 @@ pub(crate) struct VllmKvManager {
     evicted_log: Option<Vec<SequenceHash>>,
     /// G1 residency shared with this rank's G2, for retention by value.
     g1_view: Option<crate::engine::kv_retain::SharedG1View>,
+    /// With KVCR (path B block actions): each cached block's parent in its prefix chain, and how
+    /// many cached children each block has, from the same stored and removed events the router's
+    /// index reads. Demote drops only childless blocks so it never cuts a cached chain.
+    chain: Option<CachedChains>,
 }
 
 impl VllmKvManager {
@@ -393,6 +404,18 @@ impl VllmKvManager {
         self.g1_view = Some(view);
     }
 
+    /// Start tracking cached chains (see `chain`).
+    pub(crate) fn track_chains(&mut self) {
+        self.chain.get_or_insert_with(CachedChains::default);
+    }
+
+    /// Whether a cached block extends `hash` (always false when chains are not tracked).
+    pub(crate) fn has_cached_child(&self, hash: SequenceHash) -> bool {
+        self.chain
+            .as_ref()
+            .is_some_and(|c| c.children.get(&hash).is_some_and(|n| *n > 0))
+    }
+
     pub(crate) fn take_evicted(&mut self) -> Vec<SequenceHash> {
         self.evicted_log.as_mut().map(std::mem::take).unwrap_or_default()
     }
@@ -439,6 +462,7 @@ impl VllmKvManager {
             prefix_match_unit: None,
             evicted_log: None,
             g1_view: None,
+            chain: None,
         }
     }
 
@@ -1726,7 +1750,9 @@ impl VllmKvManager {
     }
 
     fn materialize_store_events(&self) -> bool {
-        !self.kv_event_publishers.is_empty() || *kv_cache_trace::KV_CACHE_TRACE_ENABLED
+        !self.kv_event_publishers.is_empty()
+            || *kv_cache_trace::KV_CACHE_TRACE_ENABLED
+            || self.chain.is_some()
     }
 
     fn publish_store_sequence(
@@ -1789,6 +1815,31 @@ impl VllmKvManager {
         if !self.enable_prefix_caching || full_blocks.is_empty() {
             return;
         }
+        if let Some(chain) = &mut self.chain {
+            if is_store {
+                let mut parent = parent_hash;
+                for &hash in &full_blocks {
+                    if let Some(p) = parent
+                        && !chain.parent_of.contains_key(&hash)
+                    {
+                        chain.parent_of.insert(hash, p);
+                        *chain.children.entry(p).or_default() += 1;
+                    }
+                    parent = Some(hash);
+                }
+            } else {
+                for hash in &full_blocks {
+                    if let Some(p) = chain.parent_of.remove(hash)
+                        && let Some(n) = chain.children.get_mut(&p)
+                    {
+                        *n -= 1;
+                        if *n == 0 {
+                            chain.children.remove(&p);
+                        }
+                    }
+                }
+            }
+        }
         if let Some(view) = &self.g1_view {
             let mut view = view.lock().unwrap();
             if is_store {
