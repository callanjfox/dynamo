-                    affected.extend(self.kv_manager.drop_cached_blocks(&g1_hashes));
+                if g1 && only_if_in_g2 {
+                    // Demote: drop only childless blocks, tail first, back to the first block G2
+                    // lacks, G1 cannot drop (in use) or another cached block extends. A block
+                    // dropped from the middle of a cached chain truncates the router indexer's
+                    // node there: the blocks after it leave the index while G1 still holds them,
+                    // and their later removals (or a store under one of them) fail ("Failed to
+                    // find block", "... parent block").
+                    if let Some(adapter) = adapter {
+                        for &hash in hashes.iter().rev() {
+                            if !self.kv_manager.has_cached_block(hash) {
+                                continue;
+                            }
+                            if !adapter.g2_resident(hash) || self.kv_manager.has_cached_child(hash) {
+                                break;
+                            }
+                            let dropped = self.kv_manager.drop_cached_blocks(&[hash]);
+                            if dropped.is_empty() {
+                                break;
+                            }
+                            affected.extend(dropped);
+                        }
+                    }
+                } else if g1 {
+                    affected.extend(self.kv_manager.drop_cached_blocks(&hashes));
                 }
                 let g1_count = affected.len();
                 if let Some(adapter) = self.native_host_offload.as_mut() {
diff --git a/crates/core/src/engine/scheduler/vllm/host_offload.rs b/crates/core/src/engine/scheduler/vllm/host_offload.rs
index 2eac01274..d8d8a9931 100644
--- a/crates/core/src/engine/scheduler/vllm/host_offload.rs
+++ b/crates/core/src/engine/scheduler/vllm/host_offload.rs
@@ -1310,7 +1310,9 @@ mod tests {
 
     #[test]
     fn demote_keeps_a_block_g2_lacks() {
-        // G2 of two blocks: a later one-block prompt evicts one of the first two.
+        // G2 of two blocks: a later one-block prompt evicts one of the first two. Demote drops only
+        // the chain's tail, back to the first block G2 lacks: a block whose next block stays in G1
+        // is kept, or the router's index would lose the blocks after it.
         let mut core = block_action_core(16, 2, false);
         let mut now_ms = 0.0;
         let tokens: Vec<u32> = (1..=8).collect();
@@ -1321,8 +1323,31 @@ mod tests {
         let in_g2: Vec<bool> = hashes.iter().map(|hash| core.kv_residency(*hash).1).collect();
         assert_eq!(in_g2.iter().filter(|held| **held).count(), 1);
         core.apply_command(drop_blocks(&hashes, true, false, true)).unwrap();
-        for (hash, held) in hashes.iter().zip(in_g2) {
-            assert_eq!(core.kv_residency(*hash), (!held, held));
+        let tail_len = in_g2.iter().rev().take_while(|held| **held).count();
+        let first_dropped = hashes.len() - tail_len;
+        for (i, (hash, held)) in hashes.iter().zip(in_g2).enumerate() {
+            assert_eq!(core.kv_residency(*hash), (i < first_dropped, held));
+        }
+    }
+
+    #[test]
+    fn demote_never_drops_a_block_whose_next_block_stays_in_g1() {
+        // G2 of eight: both blocks reach G2. Demote arrives through KVCR, which tracks cached
+        // chains (`VllmCore::set_kvcr`); this core has no KVCR registry, so track them here.
+        let mut core = block_action_core(16, 8, false);
+        core.kv_manager.track_chains();
+        let mut now_ms = 0.0;
+        let tokens: Vec<u32> = (1..=8).collect();
+        let uuid = Uuid::from_u128(47);
+        run_to_completion(&mut core, uuid, tokens.clone(), &mut now_ms);
+        let hashes = prompt_hashes(uuid, tokens);
+        // Asked to demote only the first block: the second stays in G1, so nothing is dropped.
+        core.apply_command(drop_blocks(&hashes[..1], true, false, true)).unwrap();
+        assert_eq!(core.kv_residency(hashes[0]), (true, true));
+        // The whole chain goes, tail first.
+        core.apply_command(drop_blocks(&hashes, true, false, true)).unwrap();
+        for hash in &hashes {
+            assert_eq!(core.kv_residency(*hash), (false, true));
         }
     }
 
