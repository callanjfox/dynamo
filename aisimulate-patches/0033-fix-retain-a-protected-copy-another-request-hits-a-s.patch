                                 std::backtrace::Backtrace::force_capture()
                             );
+                        } else {
+                            // Every later cut, one line each, so the count is complete.
+                            eprintln!("CHAIN_CUT rank={} hash={} n={}", self.dp_rank, hash, full_blocks.len());
                         }
                     }
                     if let Some(p) = chain.parent_of.remove(hash) {
