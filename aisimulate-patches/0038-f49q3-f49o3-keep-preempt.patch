diff --git a/crates/core/src/engine/mod.rs b/crates/core/src/engine/mod.rs
index 7de3fa4d2..89ac680e6 100644
--- a/crates/core/src/engine/mod.rs
+++ b/crates/core/src/engine/mod.rs
@@ -39,6 +39,44 @@ pub fn kvcr_reuse_field() -> bool {
 pub fn set_kvcr_reuse_field(on: bool) {
     KVCR_REUSE_FIELD.store(on, std::sync::atomic::Ordering::Relaxed);
 }
+
+static BATCH_YIELD_LEVEL: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static BATCH_YIELD_RANK: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(usize::MAX);
+static BATCH_YIELD_FINISH: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+static BATCH_YIELD_STEP_ASIDE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// f49o: a router's batch-yield signal (its `admission.batch_yield`), process-wide like class
+/// preemption: while `level > 0`, classes ranked at or above `protect_rank` under
+/// `class_scheduling` preempt lower classes for room (sparing one with at most `finish_tokens`
+/// output left) and, with `step_aside`, are protected by the class step limits.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct BatchYield {
+    pub level: f64,
+    pub protect_rank: usize,
+    pub finish_tokens: usize,
+    pub step_aside: bool,
+}
+
+pub fn set_batch_yield(level: f64, protect_rank: Option<usize>, finish_tokens: usize, step_aside: bool) {
+    use std::sync::atomic::Ordering::Relaxed;
+    BATCH_YIELD_LEVEL.store(level.max(0.0).to_bits(), Relaxed);
+    BATCH_YIELD_RANK.store(protect_rank.unwrap_or(usize::MAX), Relaxed);
+    BATCH_YIELD_FINISH.store(finish_tokens, Relaxed);
+    BATCH_YIELD_STEP_ASIDE.store(step_aside, Relaxed);
+}
+
+/// The batch-yield signal while it is up (`None` at level 0 or without a protected rank).
+pub fn batch_yield() -> Option<BatchYield> {
+    use std::sync::atomic::Ordering::Relaxed;
+    let level = f64::from_bits(BATCH_YIELD_LEVEL.load(Relaxed));
+    let rank = BATCH_YIELD_RANK.load(Relaxed);
+    (level > 0.0 && rank != usize::MAX).then(|| BatchYield {
+        level,
+        protect_rank: rank,
+        finish_tokens: BATCH_YIELD_FINISH.load(Relaxed),
+        step_aside: BATCH_YIELD_STEP_ASIDE.load(Relaxed),
+    })
+}
 pub(crate) mod kvcr;
 mod launch;
 mod offload_lru;
