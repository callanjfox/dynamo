diff --git a/crates/core/src/replay/warm_kv.rs b/crates/core/src/replay/warm_kv.rs
new file mode 100644
index 000000000..920866509
--- /dev/null
+++ b/crates/core/src/replay/warm_kv.rs
@@ -0,0 +1,178 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Warm KV for closed-loop users runs (`DYNAMO_REPLAY_WARM_KV`).
+//!
+//! A warm-start users session joins mid-conversation. Its first request, the primer (request id
+//! ending in `:primer`, one output token), carries the session's whole context, which is
+//! otherwise prefilled uncached on the GPU. With `g2`, just before a primer is submitted to the
+//! worker the router placed it on, its complete prompt blocks are made resident in that worker's
+//! host tier (G2), as if the worker had offloaded them during the session's earlier turns. The
+//! primer then finds them in G2 and loads them host to device instead of prefilling them.
+
+use std::collections::BTreeMap;
+
+use anyhow::{Result, bail};
+use rustc_hash::FxHashSet;
+use uuid::Uuid;
+
+use crate::replay::protocol::DirectRequest;
+
+pub(crate) const WARM_KV_ENV: &str = "DYNAMO_REPLAY_WARM_KV";
+
+/// How a warm-start session's context starts out.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) enum WarmKv {
+    /// Unset or `off`: a primer prefills its context like any other request.
+    #[default]
+    Off,
+    /// `g2`: a primer's prompt blocks start resident in its worker's G2.
+    G2,
+}
+
+impl WarmKv {
+    pub(crate) fn from_env() -> Result<Self> {
+        match std::env::var(WARM_KV_ENV) {
+            Ok(value) => Self::parse(&value),
+            Err(std::env::VarError::NotPresent) => Ok(Self::Off),
+            Err(error) => bail!("{WARM_KV_ENV}: {error}"),
+        }
+    }
+
+    pub(crate) fn parse(value: &str) -> Result<Self> {
+        match value.trim() {
+            "" | "off" => Ok(Self::Off),
+            "g2" => Ok(Self::G2),
+            other if other.starts_with("g2+hbm:") => bail!(
+                "{WARM_KV_ENV}={other}: seeding a share of the prefix in HBM is not implemented; use g2"
+            ),
+            other => bail!("{WARM_KV_ENV}={other}: expected off or g2"),
+        }
+    }
+}
+
+/// Whether `request` is a users-run primer: its request id ends in `:primer`.
+pub(crate) fn is_primer(request: &DirectRequest) -> bool {
+    request.replay_context.as_ref().is_some_and(|context| {
+        context.authored_id.ends_with(":primer")
+            || context
+                .agentic
+                .as_ref()
+                .is_some_and(|identity| identity.request_id.ends_with(":primer"))
+    })
+}
+
+/// Seeds of one worker.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct WorkerSeeds {
+    /// Primers whose seed made at least one block resident.
+    pub(crate) primers: u64,
+    /// Primers whose seed found nothing to add (no G2 on the worker, or every block present).
+    pub(crate) unchanged: u64,
+    /// Prompt tokens of the primers in `primers`.
+    pub(crate) prompt_tokens: u64,
+}
+
+/// Which primers were seeded, once each, and the per-worker counts.
+#[derive(Debug, Default)]
+pub(crate) struct WarmKvSeeds {
+    claimed: FxHashSet<Uuid>,
+    by_worker: BTreeMap<usize, WorkerSeeds>,
+}
+
+impl WarmKvSeeds {
+    /// True the first time primer `uuid` is about to be submitted. A primer placed again after
+    /// an `engine.dequeue` is not seeded again.
+    pub(crate) fn claim(&mut self, uuid: Uuid) -> bool {
+        self.claimed.insert(uuid)
+    }
+
+    pub(crate) fn record(&mut self, worker: usize, prompt_tokens: usize, seeded: bool) {
+        let counts = self.by_worker.entry(worker).or_default();
+        if seeded {
+            counts.primers += 1;
+            counts.prompt_tokens += prompt_tokens as u64;
+        } else {
+            counts.unchanged += 1;
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn by_worker(&self) -> &BTreeMap<usize, WorkerSeeds> {
+        &self.by_worker
+    }
+
+    /// One tracing line per worker that received a primer.
+    pub(crate) fn log_summary(&self) {
+        for (worker, counts) in &self.by_worker {
+            tracing::info!(
+                worker,
+                seeded_primers = counts.primers,
+                unchanged_primers = counts.unchanged,
+                seeded_prompt_tokens = counts.prompt_tokens,
+                "warm KV: primer prefixes seeded into G2"
+            );
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::replay::protocol::ReplayRequestContext;
+
+    fn with_id(authored_id: &str) -> DirectRequest {
+        DirectRequest {
+            replay_context: Some(ReplayRequestContext {
+                authored_id: authored_id.to_owned(),
+                ..ReplayRequestContext::default()
+            }),
+            ..DirectRequest::default()
+        }
+    }
+
+    #[test]
+    fn warm_kv_parses_off_and_g2_and_rejects_the_rest() {
+        assert_eq!(WarmKv::parse("").unwrap(), WarmKv::Off);
+        assert_eq!(WarmKv::parse("off").unwrap(), WarmKv::Off);
+        assert_eq!(WarmKv::parse(" g2 ").unwrap(), WarmKv::G2);
+        assert!(WarmKv::parse("g2+hbm:0.5").is_err());
+        assert!(WarmKv::parse("on").is_err());
+        assert_eq!(WarmKv::default(), WarmKv::Off);
+    }
+
+    #[test]
+    fn only_requests_whose_id_ends_in_primer_are_primers() {
+        assert!(is_primer(&with_id("cp000003000000:t7:primer")));
+        assert!(!is_primer(&with_id("cp000003000000:t7:r0")));
+        assert!(!is_primer(&with_id("cp000003000000:primer:r1")));
+        assert!(!is_primer(&DirectRequest::default()));
+    }
+
+    #[test]
+    fn each_primer_is_claimed_once_and_counted_by_worker() {
+        let mut seeds = WarmKvSeeds::default();
+        let primer = Uuid::from_u128(7);
+        assert!(seeds.claim(primer));
+        assert!(!seeds.claim(primer));
+        seeds.record(1, 160, true);
+        seeds.record(1, 80, true);
+        seeds.record(0, 40, false);
+        assert_eq!(
+            seeds.by_worker()[&1],
+            WorkerSeeds {
+                primers: 2,
+                unchanged: 0,
+                prompt_tokens: 240,
+            }
+        );
+        assert_eq!(
+            seeds.by_worker()[&0],
+            WorkerSeeds {
+                primers: 0,
+                unchanged: 1,
+                prompt_tokens: 0,
+            }
+        );
+    }
+}
