 .../src/engine/kv_manager/vllm_backend.rs     | 47 ++++++++++++++++---
 crates/core/src/engine/kvcr.rs                |  5 ++
 crates/core/src/engine/scheduler/vllm/core.rs | 42 ++++++++++++++++-
