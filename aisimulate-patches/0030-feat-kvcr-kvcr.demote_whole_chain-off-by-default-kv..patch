 pub(crate) struct CachedChains {
     parent_of: rustc_hash::FxHashMap<SequenceHash, SequenceHash>,
     children: rustc_hash::FxHashMap<SequenceHash, u32>,
+    /// The child last stored under each block, for `kvcr.demote_whole_chain` (followed only where
+    /// a block has exactly one cached child).
+    last_child: rustc_hash::FxHashMap<SequenceHash, SequenceHash>,
+}
+
+impl CachedChains {
+    /// The single-child chain G1 caches below `hash`, nearest first; stops at a block with no
+    /// cached child or with more than one.
+    fn only_descendants(&self, hash: SequenceHash) -> Vec<SequenceHash> {
+        let mut out = Vec::new();
+        let mut at = hash;
+        while self.children.get(&at) == Some(&1) {
+            let Some(&child) = self.last_child.get(&at) else {
+                break;
+            };
+            if self.parent_of.get(&child) != Some(&at) {
+                break;
+            }
+            out.push(child);
+            at = child;
+        }
+        out
+    }
 }
