+    /// A demote of A's prompt blocks after B extended A's chain by one block (as a turn's output
+    /// blocks extend its prompt): returns A's hashes, B's extra block, and the core.
+    fn demote_under_a_longer_chain(whole_chain: bool) -> (Vec<u64>, u64, VllmCore) {
+        let mut core = block_action_core(16, 8, false);
+        let registry = crate::engine::kvcr::KvcrRegistry::new(crate::engine::KvcrConfig {
+            demote_whole_chain: whole_chain,
+            ..Default::default()
+        });
+        core.set_kvcr(
+            Arc::clone(&registry),
+            KvHintSource {
+                worker_id: 0,
+                dp_rank: 0,
+            },
+        );
+        let mut now_ms = 0.0;
+        let a_tokens: Vec<u32> = (1..=8).collect();
+        let a = Uuid::from_u128(55);
+        run_to_completion(&mut core, a, a_tokens.clone(), &mut now_ms);
+        let b_tokens: Vec<u32> = (1..=12).collect();
+        let b = Uuid::from_u128(56);
+        run_to_completion(&mut core, b, b_tokens.clone(), &mut now_ms);
+        let a_hashes = prompt_hashes(a, a_tokens);
+        let b_hashes = prompt_hashes(b, b_tokens);
+        assert_eq!(b_hashes[..2], a_hashes[..]);
+        assert!(b_hashes.iter().all(|hash| core.kv_residency(*hash) == (true, true)));
+        core.apply_command(drop_blocks(&a_hashes, true, false, true)).unwrap();
+        (a_hashes, b_hashes[2], core)
+    }
+
+    #[test]
+    fn demote_whole_chain_drops_the_cached_blocks_below_the_request() {
+        // Off (the default): A's last block has a cached child, so nothing is dropped.
+        let (a, below, core) = demote_under_a_longer_chain(false);
+        assert!(a.iter().chain([&below]).all(|hash| core.kv_residency(*hash) == (true, true)));
+        // On: the walk starts at the chain's end, so the child and then A's blocks go, tail first.
+        let (a, below, core) = demote_under_a_longer_chain(true);
+        assert!(a.iter().chain([&below]).all(|hash| core.kv_residency(*hash) == (false, true)));
+    }
