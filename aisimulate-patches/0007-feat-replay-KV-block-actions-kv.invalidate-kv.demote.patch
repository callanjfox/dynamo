@@ -1366,6 +1378,48 @@ impl VllmKvManager {
         self.pool.set_now_ms(now_ms);
     }
 
+    /// Path B: drop the idle cached copies of `hashes` and publish their removal.
+    pub(crate) fn drop_cached_blocks(&mut self, hashes: &[SequenceHash]) -> Vec<SequenceHash> {
+        let removed = self.pool.drop_inactive(hashes);
+        // A targeted drop is not an eviction: write-back does not save it.
+        if !removed.is_empty() {
+            self.publish_kv_event(removed.clone(), &[], None, false, None, None);
+        }
+        removed
+    }
+
+    /// Whether G1 holds a cached copy of `hash`.
+    pub(crate) fn has_cached_block(&self, hash: SequenceHash) -> bool {
+        self.pool.has_cached(hash)
+    }
+
+    /// Path B prefetch: put `hashes` (a run of one prefix chain after `parent`) into G1 as
+    /// idle cached blocks, evicting ordinary LRU blocks for room, and publish them as stored.
+    /// Returns the blocks loaded; none when there is no room.
+    pub(crate) fn prefetch_cached_blocks(
+        &mut self,
+        hashes: &[SequenceHash],
+        local_hashes: &[BlockHash],
+        parent: Option<SequenceHash>,
+    ) -> Vec<SequenceHash> {
+        if hashes.is_empty() {
+            return Vec::new();
+        }
+        let Some(mut outcome) = self.pool.reserve(&[], hashes.len()) else {
+            return Vec::new();
+        };
+        self.publish_removed(std::mem::take(&mut outcome.removed));
+        let mut loaded = Vec::with_capacity(hashes.len());
+        for &hash in hashes {
+            let (copy, _) = self.pool.allocate_cached(&mut outcome.reservation, hash);
+            self.pool.release(copy);
+            loaded.push(hash);
+        }
+        self.pool.cancel(outcome.reservation);
+        self.publish_kv_event(loaded.clone(), local_hashes, parent, true, None, None);
+        loaded
+    }
+
     pub(crate) fn take_retain_broken(&mut self) -> u64 {
         self.pool.take_retain_broken()
     }
@@ -1698,6 +1752,9 @@ impl VllmKvManager {
 
     fn publish_removed(&mut self, hashes: Vec<SequenceHash>) {
         if !hashes.is_empty() {
+            if let Some(log) = &mut self.evicted_log {
+                log.extend_from_slice(&hashes);
+            }
             self.publish_kv_event(hashes, &[], None, false, None, None);
         }
     }
