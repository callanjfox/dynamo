+    /// Path B block actions on this rank (`kv.invalidate`, `kv.demote`, `kv.prefetch`).
+    /// Returns the blocks affected.
+    fn apply_kv_blocks(&mut self, command: crate::engine::KvBlockCommand, now_ms: f64) -> Vec<u64> {
+        use crate::engine::KvBlockCommand;
+        let adapter = self.native_host_offload.as_ref();
