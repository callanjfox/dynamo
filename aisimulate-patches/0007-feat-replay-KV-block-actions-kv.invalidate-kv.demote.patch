+            if tier.planned_lookup(Some(&plan), key) != Lookup::Miss {
+                continue;
+            }
+            if !tier.plan_reserve(&mut plan, key) {
+                break;
+            }
+            written.push(key);
+            written_meta.push(identity);
+        }
+        if written.is_empty() {
+            return;
+        }
