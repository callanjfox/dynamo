+/// A rank's KV blocks by sequence hash, for the router's out-of-band KV actions
+/// (path B, `kv_actions`): drop or load cached blocks outside any request.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum KvBlockCommand {
+    /// Drop cached copies of `hashes`: from G1 (`g1`) and/or G2 (`g2`). With
+    /// `only_if_in_g2`, G1 copies are dropped only where G2 holds the block
+    /// (a demote to DRAM). Copies a live request references or pins stay.
+    Drop {
+        hashes: Vec<u64>,
+        g1: bool,
+        g2: bool,
+        only_if_in_g2: bool,
+    },
+    /// Load into G1, as idle cached blocks, the blocks of a prefix chain that
+    /// G2 holds and G1 lacks (a prefetch). `local_hashes` are the blocks'
+    /// token hashes, for the KV events.
+    Prefetch {
+        hashes: Vec<u64>,
+        local_hashes: Vec<u64>,
+    },
+}
+
 /// Commands supported by the standalone scheduler.
 #[derive(Debug, Clone, PartialEq, Eq)]
 pub enum Command {
+    /// Out-of-band KV block actions (path B).
+    KvBlocks(KvBlockCommand),
     /// Submit one request.
     Submit(Request),
     /// Submit a request whose completed prefill KV must remain source-held.
