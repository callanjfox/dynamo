+                    match adapter {
+                        Some(adapter) => hashes.iter().copied().filter(|h| adapter.g2_resident(*h)).collect(),
+                        None => Vec::new(),
+                    }
+                } else {
+                    hashes.clone()
+                };
+                let mut affected = Vec::new();
+                if g1 {
+                    affected.extend(self.kv_manager.drop_cached_blocks(&g1_hashes));
+                }
+                let g1_count = affected.len();
+                if let Some(adapter) = self.native_host_offload.as_mut() {
+                    adapter.forget_g1_blocks(&affected);
+                }
+                if g2 && let Some(adapter) = self.native_host_offload.as_ref() {
+                    affected.extend(adapter.g2_drop(&hashes, now_ms));
+                }
+                if let Some(adapter) = self.native_host_offload.as_ref() {
+                    if only_if_in_g2 {
+                        adapter.note_kv_counts(0, g1_count, 0);
+                    } else {
+                        adapter.note_kv_counts(affected.len(), 0, 0);
+                    }
+                }
+                affected
+            }
+            KvBlockCommand::Prefetch {
+                hashes,
+                local_hashes,
+            } => {
+                let Some(adapter) = adapter else {
+                    return Vec::new();
+                };
+                // The chain's leading blocks: runs G2 holds and G1 lacks, each after a parent
+                // G1 holds, up to the first block neither tier holds (past it nothing can hit).
+                let mut affected = Vec::new();
+                let mut run: (Vec<u64>, Vec<u64>, Option<u64>) = (Vec::new(), Vec::new(), None);
+                let mut parent = None;
+                let mut runs = Vec::new();
+                for (index, &hash) in hashes.iter().enumerate() {
+                    if self.kv_manager.has_cached_block(hash) {
+                        if !run.0.is_empty() {
+                            runs.push(std::mem::take(&mut run));
+                        }
