+    /// Blocks with no recorded identity (output blocks) are not written, as
+    /// write-through stores prompt blocks only.
+    pub(super) fn write_back_evicted(&mut self, evicted: Vec<u64>, now_ms: f64) {
+        let Some(known) = self.write_back.as_mut() else {
+            return;
+        };
+        let mut keys = Vec::new();
+        let mut meta = Vec::new();
+        for hash in evicted {
+            let key = HostBlockKey::new(hash);
+            if let Some(identity) = known.remove(&key) {
+                keys.push(key);
+                meta.push(identity);
+            }
+        }
+        if keys.is_empty() {
+            return;
+        }
+        let mut tier = self.host.lock();
+        let mut plan = tier.plan_external(&keys, now_ms);
+        let mut written = Vec::new();
+        let mut written_meta = Vec::new();
