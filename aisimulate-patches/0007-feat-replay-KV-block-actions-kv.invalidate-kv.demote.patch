+    /// Drop the inactive cached copies of `hashes` (`kv.invalidate`, demote): copies a live
+    /// request references or pins stay. Freed capacity returns to the free pool. Returns the
+    /// hashes no longer cached, for `Removed` KV events.
+    pub(crate) fn drop_inactive(&mut self, hashes: &[SequenceHash]) -> Vec<SequenceHash> {
+        assert!(
+            self.belady.is_none(),
+            "targeted drops do not combine with the Belady eviction policy"
+        );
+        let mut removed = Vec::new();
+        for &hash in hashes {
+            loop {
+                let Some(id) = self.by_hash.get(&hash).and_then(|copies| {
+                    copies
+                        .iter()
+                        .find(|id| self.is_inactive(*id) && !self.holds_source(*id))
+                }) else {
+                    break;
+                };
+                let evicted = self.remove_inactive_copy(id);
+                if let Some(hash) = evicted.removed_hash {
+                    removed.push(hash);
+                }
+                self.free.push(evicted.source_reuse);
+            }
+        }
+        removed
+    }
+
+    /// Whether a cached copy of `hash` is resident in G1.
+    pub(crate) fn has_cached(&self, hash: SequenceHash) -> bool {
+        self.by_hash.contains_key(&hash)
+    }
