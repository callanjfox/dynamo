+    /// A fan-out replica (path B `kv.replicate`): stage one KVCR pull from `source` into this
+    /// rank's G2 of the leading blocks of `hashes` it lacks. Returns the blocks staged (they land
+    /// later, as any pull does). Without KVCR nothing is staged.
+    pub(super) fn replicate(
+        &mut self,
+        source: KvHintSource,
+        hashes: &[u64],
+        local_hashes: &[u64],
+        now_ms: f64,
+    ) -> Vec<u64> {
+        let Some(kvcr) = self.kvcr.as_mut() else {
+            return Vec::new();
+        };
+        let keys: Vec<HostBlockKey> = hashes.iter().copied().map(HostBlockKey::new).collect();
+        let meta: Vec<HostBlockMeta> = (0..keys.len())
+            .map(|index| HostBlockMeta {
+                parent: index.checked_sub(1).map(|parent| keys[parent].sequence_hash()),
+                tokens_hash: local_hashes.get(index).copied().unwrap_or_default(),
+                position: index,
+                session_id: None,
+            })
+            .collect();
+        let mut tier = self.host.lock();
+        let before: Vec<bool> = keys
+            .iter()
+            .map(|key| matches!(tier.lookup(*key), Lookup::Miss))
+            .collect();
+        let mut restore = RestoreRounds::default();
+        // The replica has no request: its pull is detached (it lands, nothing waits on it).
+        let owner = Uuid::from_u64_pair(0x7265_706c_6963_6174, hashes.first().copied().unwrap_or(0));
+        let staged = kvcr.stage(
+            &mut tier,
+            self.host.id(),
+            owner,
+            source,
+            &mut restore,
+            &keys,
+            Some(&meta),
+            now_ms,
+        );
+        if staged {
+            kvcr.release(owner);
+        }
+        keys.iter()
+            .zip(before)
+            .filter(|(key, missed)| *missed && !matches!(tier.lookup(**key), Lookup::Miss))
+            .map(|(key, _)| key.sequence_hash())
+            .collect()
+    }
+
