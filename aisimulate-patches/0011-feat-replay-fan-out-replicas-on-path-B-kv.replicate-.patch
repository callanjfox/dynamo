+    #[test]
+    fn a_replica_pulls_a_peer_prefix_into_g2_without_a_request() {
+        let config = crate::engine::KvcrConfig {
+            latency_to_first_byte_ms: 1.0,
+            bandwidth_gbps: 1.0,
+            ..Default::default()
+        };
+        let (registry, ranks, [mut source, mut target]) = kvcr_workers(config, [4, 4]);
+        let keys: Vec<HostBlockKey> = [11_u64, 12].into_iter().map(HostBlockKey::new).collect();
+        for key in &keys {
+            seed_host(&mut source, *key);
+        }
+        let hashes: Vec<u64> = keys.iter().map(|k| k.sequence_hash()).collect();
+        // Staged: both blocks, from the source's G2.
+        let staged = target.replicate(ranks[0], &hashes, &[1, 2], 0.0);
+        assert_eq!(staged, hashes);
+        registry.lock().unwrap().start_parked();
+        let mut manager = G1Manager::new_with_caching(4, 4, KvEventPublishers::default(), 0, true);
+        assert!(target.advance(&mut manager, 3.0).completed_any);
+        for key in &keys {
+            assert_eq!(target.host.lock().lookup(*key), Lookup::Hit);
+        }
+        // Already held: nothing more is staged; from itself, nothing.
+        assert!(target.replicate(ranks[0], &hashes, &[1, 2], 4.0).is_empty());
+        assert!(source.replicate(ranks[0], &hashes, &[1, 2], 4.0).is_empty());
+        // Without KVCR, nothing.
+        let mut plain = adapter(4);
+        assert!(plain.replicate(ranks[0], &hashes, &[1, 2], 0.0).is_empty());
+    }
