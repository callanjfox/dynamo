--- a/crates/core/src/engine/config.rs
+++ b/crates/core/src/engine/config.rs
@@ -550,6 +550,16 @@ pub struct NativeHostOffloadConfig {
     /// copy. Private (`dp_rank_local`) G2 only.
     #[serde(default, skip_serializing_if = "std::ops::Not::not")]
     pub write_back: bool,
+    /// Rank G2 blocks as vLLM's CPU offloading LRU does (`vllm/v1/kv_offload/cpu/policies/lru.py`
+    /// `LRUCachePolicy`; `cpu/manager.py` `prepare_store`, `complete_store`, `prepare_load`,
+    /// `complete_load`): a block takes its rank when it is admitted (a store or a KVCR landing is
+    /// reserved, in request order), and only touches change it. Pins and transfer completions never
+    /// re-rank: a store's completion and a load's or pull's unpin leave the block where it was
+    /// (`mark_evictable` re-enters it at its rank). Off by default: a block joins the LRU when its
+    /// transfer completes, and completions and unpins make their blocks the newest, in key order.
+    /// Private (`dp_rank_local`) G2 only.
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub vllm_recency: bool,
 }
 
 impl NativeHostOffloadConfig {
@@ -564,6 +574,7 @@ impl NativeHostOffloadConfig {
             latency_to_first_byte_ms: 0.0,
             kv_layout_id: None,
             write_back: false,
+            vllm_recency: false,
         }
     }
 
