+    /// `native_host_offload.vllm_recency`, as vLLM's `LRUCachePolicy`.
+    fn vllm_tier(capacity_blocks: usize) -> HostTier {
+        let mut tier = tier(capacity_blocks);
+        tier.config.vllm_recency = true;
+        tier
+    }
+
+    #[test]
+    fn vllm_recency_ranks_a_store_at_admission_and_completion_keeps_the_rank() {
+        // `prepare_store` inserts in request order; `complete_store` re-enters at that rank.
+        let mut tier = vllm_tier(4);
+        let now = make_resident(&mut tier, &[key(2), key(1)], 0.0);
+        let StoreOutcome::Prepared { transfer_id, .. } =
+            tier.prepare_store(C, request_id(), &[key(3)], None, now)
+        else {
+            panic!("absent block should store")
+        };
+        tier.touch(key(2));
+        // `3` was ranked at admission, before the touch; still pending, it is not a victim.
+        assert_eq!(tier.lru.order(), [key(1), key(3), key(2)]);
+        assert_eq!(tier.submit_prepared_stores(C, now), 1);
+        let deadline = tier.transfer_deadline(transfer_id).unwrap();
+        tier.tick(C, deadline);
+        assert_eq!(tier.lru.order(), [key(1), key(3), key(2)]);
+    }
+
+    #[test]
+    fn vllm_recency_keeps_a_load_pinned_block_at_its_rank() {
+        // `prepare_load` makes a chunk non-evictable without moving it; when the load ends
+        // `mark_evictable` re-enters it at its rank. Off, it re-enters as the newest.
+        let mut tier = vllm_tier(3);
+        let now = make_resident(&mut tier, &[key(1), key(2)], 0.0);
+        let LoadOutcome::Queued(load) = tier.schedule_load(C, request_id(), &[key(1)], now, now)
+        else {
+            panic!("resident block should load")
+        };
+        assert_eq!(tier.lru.order(), [key(1), key(2)]);
+        // `1` is the oldest but pinned: a store needing two blocks evicts `2`, not `1`.
+        assert!(matches!(
+            tier.prepare_store(C, request_id(), &[key(3), key(4)], None, now),
+            StoreOutcome::Prepared { .. }
+        ));
+        assert!(tier.is_resident(key(1)));
+        assert_eq!(tier.lookup(key(2)), Lookup::Miss);
+        assert!(tier.cancel_load(C, load, now, now));
+        assert_eq!(tier.lru.order(), [key(1), key(3), key(4)]);
+    }
+
