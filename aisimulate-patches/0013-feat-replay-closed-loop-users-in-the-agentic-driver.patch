+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::replay::loadgen::WorkloadDriver;
+
+    // Template 0: r0 (2 blocks), then r1 after r0 completes plus 1 s (r0's 2 blocks plus 1 new).
+    // Template 1: one request of 1 block.
+    fn corpus() -> Arc<UsersCorpus> {
+        let rows = [
+            r#"{"i":0,"blocks":3,"nodes":[["t0:r0","t0:s",8,2,0.0,[],-1,0,[0,1]],["t0:r1","t0:s",12,2,0.0,[[0,1,1000.0,0]],0,2,[2]]]}"#,
+            r#"{"i":1,"blocks":1,"nodes":[["t1:r0","t1:s",4,1,0.0,[],-1,0,[0]]]}"#,
+        ];
+        let templates = rows
+            .iter()
+            .map(|r| UsersCorpus::template(serde_json::from_str(r).unwrap(), 4).unwrap())
+            .collect();
+        Arc::new(UsersCorpus {
+            templates,
+            block_size: 4,
+        })
+    }
+
+    fn driver(horizon_s: f64) -> WorkloadDriver {
+        let users = AgenticUsers::new(corpus(), vec![vec![0, 1], vec![1, 0]], horizon_s, 2.0, 120.0)
+            .unwrap();
+        WorkloadDriver::new_agentic_users(users, 4, true).unwrap()
+    }
+
+    fn id(turn: &crate::replay::loadgen::ReadyTurn) -> String {
+        turn.authored_request_id.clone().unwrap()
+    }
+
+    #[test]
+    fn templates_rebuild_prompts_from_deltas() {
+        let c = corpus();
+        assert_eq!(c.templates[0].ranks(0), vec![0, 1]);
+        assert_eq!(c.templates[0].ranks(1), vec![0, 1, 2]);
+        assert_eq!(c.templates[0].roots, vec![0]);
+    }
+
+    #[test]
+    fn users_play_their_entries_in_order_with_cooldown_and_own_blocks() {
+        let mut d = driver(3600.0);
+        let mut first = d.pop_ready(0.0, usize::MAX);
+        first.sort_by_key(id);
+        let ids = first.iter().map(id).collect::<Vec<_>>();
+        assert_eq!(ids, vec!["cp000000000000:t0:r0", "cp000001000000:t1:r0"]);
+        // Copies of different templates (and of the same one, below) never share blocks.
+        let a0 = first[0].request.tokens.clone();
+        let b0 = first[1].request.tokens.clone();
+        assert!(a0.iter().all(|t| !b0.contains(t)));
+        // User 1's play ends at 5 s; its next entry (template 0) starts after the 2 s cooldown.
+        d.on_complete(first[1].request_uuid, 5000.0).unwrap();
+        assert_eq!(d.next_ready_time_ms(), Some(7000.0));
+        assert!(d.pop_ready(6999.0, usize::MAX).is_empty());
+        let second = d.pop_ready(7000.0, usize::MAX);
+        assert_eq!(second.iter().map(id).collect::<Vec<_>>(), vec!["cp000001000001:t0:r0"]);
+        let c0 = second[0].request.tokens.clone();
+        assert!(c0.iter().all(|t| !a0.contains(t)), "two copies of one template share no blocks");
+        // Within a copy, the next request extends the previous prompt (released 1 s after completion).
+        d.on_complete(first[0].request_uuid, 10_000.0).unwrap();
+        assert!(d.pop_ready(10_999.0, usize::MAX).is_empty());
+        let next = d.pop_ready(11_000.0, usize::MAX);
+        assert_eq!(id(&next[0]), "cp000000000000:t0:r1");
+        let a1 = next[0].request.tokens.clone();
+        assert_eq!(&a1[..a0.len()], &a0[..]);
+        assert_eq!(a1.len(), 12);
+    }
+
+    #[test]
+    fn nothing_is_dispatched_at_or_after_the_horizon() {
+        let mut d = driver(10.0);
+        let mut first = d.pop_ready(0.0, usize::MAX);
+        first.sort_by_key(id);
+        // User 0's second request would be ready at 9.5 s + 1 s, past the 10 s horizon.
+        d.on_complete(first[0].request_uuid, 9500.0).unwrap();
+        // User 1's next play would start at 9 s + 2 s.
+        d.on_complete(first[1].request_uuid, 9000.0).unwrap();
+        assert_eq!(d.next_ready_time_ms(), None);
+        assert!(d.pop_ready(20_000.0, usize::MAX).is_empty());
+        assert!(d.is_drained());
+    }
+
+    #[test]
+    fn a_failed_play_waits_the_loss_cooldown() {
+        let mut d = driver(3600.0);
+        let mut first = d.pop_ready(0.0, usize::MAX);
+        first.sort_by_key(id);
+        d.on_terminal(
+            first[1].request_uuid,
+            1000.0,
+            crate::replay::ReplayTerminalStatus::Rejected,
+        )
+        .unwrap();
+        assert_eq!(d.next_ready_time_ms(), Some(121_000.0));
+    }
+}
