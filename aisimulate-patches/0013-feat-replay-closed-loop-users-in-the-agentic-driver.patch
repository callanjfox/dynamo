+/// Closed-loop users (`super::users`): copies of play templates started per user, freed when settled.
+impl WorkloadDriver {
+    /// A users run: one lane per user, each starting its first schedule entry at time 0.
+    pub fn new_agentic_users(
+        users: super::users::AgenticUsers,
+        engine_block_size: usize,
+        include_replay_hashes: bool,
+    ) -> Result<Self> {
+        if engine_block_size == 0 {
+            bail!("engine_block_size must be greater than 0");
+        }
+        let engine_block_size_u32 =
+            u32::try_from(engine_block_size).context("engine_block_size does not fit in u32")?;
+        let lanes = users.plans.len();
+        let trace_block_size = users.corpus.block_size;
+        let state = AgenticState {
+            compressed_warmup_timing: false,
+            identities: Vec::new(),
+            node_states: Vec::new(),
+            remaining_dependencies: Vec::new(),
+            authored_not_before_ms: Vec::new(),
+            ready_after_ms: Vec::new(),
+            dispatch_dependents: Vec::new(),
+            completion_dependents: Vec::new(),
+            node_to_play: Vec::new(),
+            plays: Vec::new(),
+            lanes: (0..lanes)
+                .map(|_| AgenticLaneState { active_play: None })
+                .collect(),
+            next_pending_play: 0,
+            lifecycle: Vec::new(),
+            next_lifecycle_ordinal: 0,
+            last_runtime_feedback_at_ms: None,
+            users_released: Some(Vec::new()),
+        };
+        let mut driver = Self {
+            policy: SchedulingPolicy::Agentic(Box::new(state)),
+            prompt_mode: PromptMode::Full,
+            emit_session_metadata: true,
+            trace_block_size,
+            engine_block_size: engine_block_size_u32,
+            include_replay_hashes,
+            agentic_graph_identity: None,
+            agentic_replay_context: None,
+            agentic_snapshots: None,
+            agentic_preparation: None,
+            agentic_profile: None,
+            agentic_speedup: 1.0,
+            sessions: Vec::new(),
+            in_flight: FxHashMap::default(),
+            agentic_settling: FxHashMap::default(),
+            ready_sessions: BinaryHeap::new(),
+            users: Some(Box::new(super::users::UsersRuntime::new(users))),
+        };
+        for user in 0..lanes {
+            driver.users_start_next(user, 0.0)?;
+        }
+        Ok(driver)
+    }
+
+    /// Starts user `user`'s next schedule entry at `start_ms` (its roots become ready then), unless
+    /// the user has none left or the start is at or past the horizon. An empty template is skipped.
+    fn users_start_next(&mut self, user: usize, start_ms: f64) -> Result<()> {
+        let users = self.users.as_mut().expect("users run");
+        if start_ms >= users.horizon_ms() {
+            return Ok(());
+        }
+        let corpus = Arc::clone(&users.spec.corpus);
+        let (position, template_index) = loop {
+            let position = users.next_entry[user];
+            let Some(&template_index) = users.spec.plans[user].get(position) else {
+                users.users_out_of_entries += 1;
+                tracing::warn!(user, position, "users run: a user ran out of schedule entries");
+                return Ok(());
+            };
+            users.next_entry[user] += 1;
+            if !corpus.templates[template_index].nodes.is_empty() {
+                break (position, template_index);
+            }
+        };
+        let template = &corpus.templates[template_index];
+        let token_base = users.reserve_tokens(template_index)?;
+        let SchedulingPolicy::Agentic(state) = &mut self.policy else {
+            unreachable!("users runs are agentic")
+        };
+        let node_offset = self.sessions.len();
+        let play_index = state.plays.len();
+        let count = template.nodes.len();
+        for (k, node) in template.nodes.iter().enumerate() {
+            let ordinal = u128::try_from(node_offset + k + 1)?;
+            self.sessions.push(SessionRuntime {
+                session_id: String::new(),
+                turns: vec![TurnRuntime {
+                    request_id: None,
+                    play_id: None,
+                    replay_key: None,
+                    prompt_tokens: PromptTokens::Users {
+                        input_length: node.input_length,
+                    },
+                    max_output_tokens: node.output_length,
+                    output_token_ids: None,
+                    delay_after_previous_ms: 0.0,
+                    priority: 0,
+                    strict_priority: 0,
+                    policy_class: None,
+                    synthetic_session_id: false,
+                    images: Vec::new(),
+                    deterministic_request_id: Some(Uuid::from_u128(ordinal)),
+                }],
+                cumulative_tokens: Vec::new(),
+                next_turn_index: 0,
+                next_ready_at_ms: None,
+                in_flight: None,
+            });
+            state.node_states.push(AgenticNodeState::Blocked);
+            state.remaining_dependencies.push(node.dependencies.len());
+            state.authored_not_before_ms.push(node.not_before_ms);
+            state.ready_after_ms.push(node.not_before_ms);
+            state.dispatch_dependents.push(Vec::new());
+            state.completion_dependents.push(Vec::new());
+            state.node_to_play.push(play_index);
+        }
+        for (k, node) in template.nodes.iter().enumerate() {
+            for dependency in &node.dependencies {
+                let source = node_offset + dependency.node as usize;
+                let edge = AgenticDependentEdge {
+                    target_node: node_offset + k,
+                    delay_ms: dependency.delay_ms,
+                };
+                if dependency.dispatch {
+                    state.dispatch_dependents[source].push(edge);
+                } else {
+                    state.completion_dependents[source].push(edge);
+                }
+            }
+        }
+        let copy = super::users::UserCopy {
+            user: u32::try_from(user)?,
+            position: u32::try_from(position)?,
+            template: u32::try_from(template_index)?,
+            token_base,
+            node_offset,
+            freed: false,
+        };
+        let mut play = AgenticPlayState::new(
+            format!("users:{}", super::users::UsersRuntime::key(&copy)),
+            (node_offset..node_offset + count).collect(),
+            template.roots.iter().map(|&r| node_offset + r as usize).collect(),
+        );
+        play.lane_index = Some(user);
+        state.plays.push(play);
+        state.lanes[user].active_play = Some(play_index);
+        users.copies.push(copy);
+        state.activate_play(play_index, start_ms, &mut self.sessions, &mut self.ready_sessions);
+        Ok(())
+    }
+
+    /// Starts the next entry of every user whose play finished since the last call.
+    fn users_refill(&mut self) -> Result<()> {
+        let Some(users) = &self.users else {
+            return Ok(());
+        };
+        let (cooldown_ms, loss_ms) = (users.spec.cooldown_ms, users.spec.loss_cooldown_ms);
+        let SchedulingPolicy::Agentic(state) = &mut self.policy else {
+            return Ok(());
+        };
+        let released = std::mem::take(state.users_released.as_mut().expect("users run"));
+        for (user, at_ms, failed) in released {
+            self.users_start_next(user, at_ms + if failed { loss_ms } else { cooldown_ms })?;
+        }
+        Ok(())
+    }
+
+    /// Builds a copy's request at dispatch: identity, prompt blocks and planned output.
+    fn users_prepare_dispatch(&mut self, session_index: usize) -> AgenticRuntimeIdentity {
+        let users = self.users.as_ref().expect("users run");
+        let SchedulingPolicy::Agentic(state) = &self.policy else {
+            unreachable!("users runs are agentic")
+        };
+        let copy = users.copies[state.node_to_play[session_index]];
+        let node = session_index - copy.node_offset;
+        let identity = users.identity(&copy, node);
+        let hash_ids = users.hash_ids(&copy, node);
+        let session = &mut self.sessions[session_index];
+        session.session_id = identity.conversation_id.clone();
+        let turn = &mut session.turns[0];
+        turn.request_id = Some(identity.request_id.clone());
+        turn.play_id = Some(identity.play_id.clone());
+        let mut rng = StdRng::seed_from_u64(
+            SYNTHETIC_OUTPUT_SEED ^ (session_index as u64 + 1).wrapping_mul(0x9E37_79B9_7F4A_7C15),
+        );
+        turn.output_token_ids = Some(planned_output_token_ids(
+            None,
+            turn.max_output_tokens,
+            &mut rng,
+        ));
+        turn.prompt_tokens = PromptTokens::Deferred {
+            input_length: turn.prompt_tokens.input_length(),
+            hash_ids,
+        };
+        identity
+    }
+
+    /// Frees a copy's nodes once its play has settled (client finished, every request quiescent).
+    fn users_free_if_settled(&mut self, node_index: usize) {
+        let SchedulingPolicy::Agentic(state) = &mut self.policy else {
+            return;
+        };
+        let play_index = state.node_to_play[node_index];
+        let users = self.users.as_mut().expect("users run");
+        let copy = &mut users.copies[play_index];
+        if copy.freed || !state.plays[play_index].quiescent {
+            return;
+        }
+        copy.freed = true;
+        let nodes = std::mem::take(&mut state.plays[play_index].nodes);
+        state.plays[play_index].root_nodes = Vec::new();
+        for index in nodes {
+            let session = &mut self.sessions[index];
+            session.session_id = String::new();
+            session.turns = Vec::new();
+            session.next_ready_at_ms = None;
+            state.dispatch_dependents[index] = Vec::new();
+            state.completion_dependents[index] = Vec::new();
+        }
+    }
+
+    /// Users that ran out of schedule entries before the horizon (users runs only).
+    pub fn users_out_of_entries(&self) -> Option<usize> {
+        self.users.as_ref().map(|users| users.users_out_of_entries)
+    }
+}
