+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Closed-loop users for agentic replay: N user slots, each playing a scheduled sequence of play
+//! templates, one after another, for a fixed horizon.
+//!
+//! Finite agentic replay preloads every request of every play as a graph node and runs each play
+//! once. A users run instead keeps each play's requests once as a template (hash IDs stored as a
+//! delta on an earlier request of the same play) and instantiates a copy of a template only when a
+//! user starts it, freeing the copy's nodes when it settles. Each copy gets its own block identity
+//! range, so copies never share KV, and its own request, session and play identity
+//! (`cp<key>:<template request id>`, key = user and position, six digits each).
+//!
+//! The schedule (which template each user plays at each position, its class) is drawn outside,
+//! once, so another simulator can run the same plays. A user starts its next entry when its play's
+//! client work finishes (after `cooldown_s`, or `loss_cooldown_s` when the play failed); nothing is
+//! dispatched at or after the horizon.
+
+use std::io::{BufRead, BufReader};
+use std::path::Path;
+use std::sync::Arc;
+
+use anyhow::{Context, Result, bail, ensure};
+use serde::Deserialize;
+
+use super::AgenticDependencyRelation;
+use crate::replay::AgenticRuntimeIdentity;
+
+const NO_BASE: u32 = u32::MAX;
+
+#[derive(Debug)]
+pub(super) struct TemplateDependency {
+    pub(super) node: u32,
+    pub(super) dispatch: bool,
+    pub(super) delay_ms: f64,
+}
+
+#[derive(Debug)]
+pub(super) struct TemplateNode {
+    pub(super) request_id: String,
+    pub(super) session_id: String,
+    pub(super) input_length: usize,
+    pub(super) output_length: usize,
+    pub(super) not_before_ms: f64,
+    pub(super) dependencies: Vec<TemplateDependency>,
+    /// The request whose spawn started this one (a subagent's first request).
+    pub(super) spawn_parent: Option<u32>,
+    base: u32,
+    prefix: u32,
+    new_ranks: Vec<u32>,
+}
+
+#[derive(Debug)]
+pub(super) struct PlayTemplate {
+    pub(super) nodes: Vec<TemplateNode>,
+    pub(super) roots: Vec<u32>,
+    /// Distinct play-local block ranks (each copy reserves this many block identities).
+    pub(super) blocks: u32,
+}
+
+impl PlayTemplate {
+    /// The play-local block ranks of node `index`'s prompt.
+    fn ranks(&self, index: usize) -> Vec<u32> {
+        let node = &self.nodes[index];
+        let mut need = node.prefix as usize + node.new_ranks.len();
+        let mut segments: Vec<(usize, usize)> = Vec::new();
+        let mut cur = index;
+        loop {
+            let n = &self.nodes[cur];
+            let prefix = n.prefix as usize;
+            if need > prefix {
+                segments.push((cur, need - prefix));
+                need = prefix;
+            }
+            if need == 0 {
+                break;
+            }
+            cur = n.base as usize;
+        }
+        let mut out = Vec::with_capacity(node.prefix as usize + node.new_ranks.len());
+        for (at, take) in segments.into_iter().rev() {
+            out.extend_from_slice(&self.nodes[at].new_ranks[..take]);
+        }
+        out
+    }
+}
