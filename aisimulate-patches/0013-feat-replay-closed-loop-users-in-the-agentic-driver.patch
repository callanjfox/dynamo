+/// Play templates, loaded once (`templates.jsonl` from the users exporter).
+#[derive(Debug)]
+pub struct UsersCorpus {
+    pub(super) templates: Vec<PlayTemplate>,
+    pub(super) block_size: usize,
+}
+
+#[derive(Deserialize)]
+struct TemplatesHeader {
+    schema: String,
+    block_size: usize,
+    templates: usize,
+}
+
+#[derive(Deserialize)]
+struct TemplateRow {
+    i: usize,
+    blocks: u32,
+    nodes: Vec<NodeRow>,
+}
+
+// [request_id, session_id, input_length, output_length, not_before_ms, deps, base, prefix, new_ranks];
+// deps: [node, trigger (0 dispatch, 1 completion), delay_ms, relation (0 sequence, 1 spawn, 2 join, 3 barrier)].
+#[derive(Deserialize)]
+struct NodeRow(
+    String,
+    String,
+    usize,
+    usize,
+    f64,
+    Vec<(u32, u8, f64, u8)>,
+    i64,
+    u32,
+    Vec<u32>,
+);
+
+impl UsersCorpus {
+    pub fn load(path: &Path) -> Result<Self> {
+        let file = std::fs::File::open(path)
+            .with_context(|| format!("opening users templates {}", path.display()))?;
+        let mut lines = BufReader::new(file).lines();
+        let header: TemplatesHeader = serde_json::from_str(
+            &lines
+                .next()
+                .context("users templates file is empty")??,
+        )?;
+        ensure!(
+            header.schema == "dynosim.users.templates",
+            "unknown users templates schema {}",
+            header.schema
+        );
+        let mut templates = Vec::with_capacity(header.templates);
+        for (number, line) in lines.enumerate() {
+            let line = line?;
+            if line.trim().is_empty() {
+                continue;
+            }
+            let row: TemplateRow = serde_json::from_str(&line)
+                .with_context(|| format!("{}:{}", path.display(), number + 2))?;
+            ensure!(row.i == templates.len(), "templates must be numbered in order");
+            templates.push(Self::template(row, header.block_size)?);
+        }
+        ensure!(
+            templates.len() == header.templates,
+            "users templates header announces {} templates, file has {}",
+            header.templates,
+            templates.len()
+        );
+        Ok(Self {
+            templates,
+            block_size: header.block_size,
+        })
+    }
+
+    fn template(row: TemplateRow, block_size: usize) -> Result<PlayTemplate> {
+        let count = row.nodes.len();
+        let mut lengths = Vec::with_capacity(count);
+        let mut nodes = Vec::with_capacity(count);
+        let mut roots = Vec::new();
+        for (index, NodeRow(request_id, session_id, input, output, not_before, deps, base, prefix, new_ranks)) in
+            row.nodes.into_iter().enumerate()
+        {
+            let (base, prefix) = if base < 0 {
+                ensure!(prefix == 0, "{request_id}: a prefix needs a base request");
+                (NO_BASE, 0)
+            } else {
+                let base = usize::try_from(base)?;
+                ensure!(base < index, "{request_id}: a base must be an earlier request");
+                ensure!(
+                    prefix as usize <= lengths[base],
+                    "{request_id}: prefix longer than its base"
+                );
+                (u32::try_from(base)?, prefix)
+            };
+            ensure!(
+                new_ranks.iter().all(|&r| r < row.blocks),
+                "{request_id}: block rank outside the template"
+            );
+            let total = prefix as usize + new_ranks.len();
+            super::trace::validate_synthesizable_prompt_len(input, total, block_size)
+                .with_context(|| request_id.clone())?;
+            lengths.push(total);
+            ensure!(
+                not_before.is_finite() && not_before >= 0.0,
+                "{request_id}: invalid not_before_ms"
+            );
+            let mut dependencies = Vec::with_capacity(deps.len());
+            let mut spawn_parent = None;
+            for (node, trigger, delay_ms, relation) in deps {
+                ensure!((node as usize) < count, "{request_id}: unknown dependency");
+                ensure!(
+                    delay_ms.is_finite() && delay_ms >= 0.0,
+                    "{request_id}: invalid dependency delay"
+                );
+                let relation = match relation {
+                    0 => AgenticDependencyRelation::Sequence,
+                    1 => AgenticDependencyRelation::Spawn,
+                    2 => AgenticDependencyRelation::Join,
+                    3 => AgenticDependencyRelation::ReplayBarrier,
+                    other => bail!("{request_id}: unknown dependency relation {other}"),
+                };
+                if relation == AgenticDependencyRelation::Spawn {
+                    spawn_parent = Some(spawn_parent.map_or(node, |p: u32| p.min(node)));
+                }
+                dependencies.push(TemplateDependency {
+                    node,
+                    dispatch: trigger == 0,
+                    delay_ms,
+                });
+            }
+            if dependencies.is_empty() {
+                roots.push(u32::try_from(index)?);
+            }
+            nodes.push(TemplateNode {
+                request_id,
+                session_id,
+                input_length: input,
+                output_length: output,
+                not_before_ms: not_before,
+                dependencies,
+                spawn_parent,
+                base,
+                prefix,
+                new_ranks,
+            });
+        }
+        ensure!(count == 0 || !roots.is_empty(), "a template needs a root request");
+        Ok(PlayTemplate {
+            nodes,
+            roots,
+            blocks: row.blocks,
+        })
+    }
+}
