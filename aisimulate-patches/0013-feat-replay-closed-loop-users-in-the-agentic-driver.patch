+/// A users run: templates, each user's entries (template indexes), the horizon and cooldowns.
+#[derive(Debug)]
+pub struct AgenticUsers {
+    pub(super) corpus: Arc<UsersCorpus>,
+    pub(super) plans: Vec<Vec<usize>>,
+    pub(super) horizon_ms: f64,
+    pub(super) cooldown_ms: f64,
+    pub(super) loss_cooldown_ms: f64,
+}
+
+impl AgenticUsers {
+    /// Reads a schedule file (`schedule.json` from the users exporter) and its templates.
+    pub fn load(schedule: &Path) -> Result<Self> {
+        let text = std::fs::read_to_string(schedule)
+            .with_context(|| format!("reading users schedule {}", schedule.display()))?;
+        let file: ScheduleFile = serde_json::from_str(&text)
+            .with_context(|| format!("parsing users schedule {}", schedule.display()))?;
+        ensure!(
+            file.schema == "dynosim.users.schedule",
+            "unknown users schedule schema {}",
+            file.schema
+        );
+        let templates = Path::new(&file.templates);
+        let templates = if templates.is_absolute() {
+            templates.to_path_buf()
+        } else {
+            schedule
+                .parent()
+                .unwrap_or_else(|| Path::new("."))
+                .join(templates)
+        };
+        let corpus = Arc::new(UsersCorpus::load(&templates)?);
+        let plans = file
+            .plan
+            .into_iter()
+            .map(|user| user.entries.into_iter().map(|e| e.tmpl).collect::<Vec<_>>())
+            .collect::<Vec<_>>();
+        Self::new(
+            corpus,
+            plans,
+            file.horizon_s,
+            file.cooldown_s,
+            file.loss_cooldown_s,
+        )
+    }
+
+    pub(super) fn new(
+        corpus: Arc<UsersCorpus>,
+        plans: Vec<Vec<usize>>,
+        horizon_s: f64,
+        cooldown_s: f64,
+        loss_cooldown_s: f64,
+    ) -> Result<Self> {
+        ensure!(!plans.is_empty(), "a users run needs at least one user");
+        ensure!(
+            plans.len() < 1_000_000,
+            "copy keys allow fewer than 1,000,000 users"
+        );
+        for entries in &plans {
+            ensure!(
+                entries.len() < 1_000_000,
+                "copy keys allow fewer than 1,000,000 entries per user"
+            );
+            for &t in entries {
+                ensure!(t < corpus.templates.len(), "schedule names unknown template {t}");
+            }
+        }
+        for (name, v) in [
+            ("horizon_s", horizon_s),
+            ("cooldown_s", cooldown_s),
+            ("loss_cooldown_s", loss_cooldown_s),
+        ] {
+            ensure!(v.is_finite() && v >= 0.0, "{name} must be finite and >= 0");
+        }
+        Ok(Self {
+            corpus,
+            plans,
+            horizon_ms: horizon_s * 1000.0,
+            cooldown_ms: cooldown_s * 1000.0,
+            loss_cooldown_ms: loss_cooldown_s * 1000.0,
+        })
+    }
+}
+
+/// One instantiated copy of a template (one per agentic play of a users run).
+#[derive(Debug, Clone, Copy)]
+pub(super) struct UserCopy {
+    pub(super) user: u32,
+    pub(super) position: u32,
+    pub(super) template: u32,
+    pub(super) token_base: u32,
+    pub(super) node_offset: usize,
+    pub(super) freed: bool,
+}
+
+#[derive(Debug)]
+pub(super) struct UsersRuntime {
+    pub(super) spec: AgenticUsers,
+    /// Next schedule position per user.
+    pub(super) next_entry: Vec<usize>,
+    /// By agentic play index.
+    pub(super) copies: Vec<UserCopy>,
+    next_token_base: u64,
+    pub(super) users_out_of_entries: usize,
+}
+
+impl UsersRuntime {
+    pub(super) fn new(spec: AgenticUsers) -> Self {
+        let users = spec.plans.len();
+        Self {
+            spec,
+            next_entry: vec![0; users],
+            copies: Vec::new(),
+            next_token_base: 0,
+            users_out_of_entries: 0,
+        }
+    }
+
+    pub(super) fn horizon_ms(&self) -> f64 {
+        self.spec.horizon_ms
+    }
+
+    /// Reserves the block identity range of a new copy of template `template`.
+    pub(super) fn reserve_tokens(&mut self, template: usize) -> Result<u32> {
+        let base = self.next_token_base;
+        let blocks = u64::from(self.spec.corpus.templates[template].blocks.max(1));
+        let end = base + blocks;
+        if end > u64::from(u32::MAX) {
+            bail!("users run exhausted the u32 block identity space after {} copies", self.copies.len());
+        }
+        self.next_token_base = end;
+        Ok(base as u32)
+    }
+
+    pub(super) fn key(copy: &UserCopy) -> String {
+        format!("{:06}{:06}", copy.user, copy.position)
+    }
+
+    /// The prompt's block identities for node `node` of copy `copy`.
+    pub(super) fn hash_ids(&self, copy: &UserCopy, node: usize) -> Vec<u32> {
+        let mut ids = self.spec.corpus.templates[copy.template as usize].ranks(node);
+        for id in &mut ids {
+            *id += copy.token_base;
+        }
+        ids
+    }
+
+    /// Request id, play id, conversation id and identity of node `node` of copy `copy`.
+    pub(super) fn identity(&self, copy: &UserCopy, node: usize) -> AgenticRuntimeIdentity {
+        let template = &self.spec.corpus.templates[copy.template as usize];
+        let n = &template.nodes[node];
+        let key = Self::key(copy);
+        AgenticRuntimeIdentity {
+            request_id: format!("cp{key}:{}", n.request_id),
+            play_id: format!("users:{key}"),
+            conversation_id: format!("cp{key}:{}", n.session_id),
+            lane_id: Some(format!("lane:{}", copy.user)),
+            root_id: None,
+            parent_id: n
+                .spawn_parent
+                .map(|p| format!("cp{key}:{}", template.nodes[p as usize].request_id)),
+            cache_id: None,
+            lineage: None,
+        }
+    }
+}
