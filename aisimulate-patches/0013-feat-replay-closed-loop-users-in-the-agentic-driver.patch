+#[derive(Deserialize)]
+struct ScheduleFile {
+    schema: String,
+    horizon_s: f64,
+    #[serde(default)]
+    cooldown_s: f64,
+    #[serde(default)]
+    loss_cooldown_s: f64,
+    templates: String,
+    plan: Vec<PlanUser>,
+}
+
+#[derive(Deserialize)]
+struct PlanUser {
+    #[allow(dead_code)]
+    cls: String,
+    entries: Vec<PlanEntry>,
+}
+
+#[derive(Deserialize)]
+struct PlanEntry {
+    tmpl: usize,
+}
