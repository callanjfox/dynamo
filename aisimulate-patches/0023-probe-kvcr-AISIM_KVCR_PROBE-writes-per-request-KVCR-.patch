+    /// KVCR probe (`AISIM_KVCR_PROBE`): the leading blocks of `keys` that this rank's G2, the
+    /// longest-holding peer's G2 and the hinted source's G2 hold now, as one JSON line.
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn probe(
+        &self,
+        own: &HostTier,
+        event: &str,
+        owner: Uuid,
+        keys: &[HostBlockKey],
+        hint: Option<KvHintSource>,
+        g1_blocks: Option<usize>,
+        now: Option<f64>,
+    ) {
+        let lead = |tier: &HostTier| {
+            keys.iter()
+                .take_while(|key| matches!(tier.lookup(**key), Lookup::Hit))
+                .count()
+        };
+        let own_blocks = lead(own);
+        let peers = self.registry.lock().unwrap().peer_tiers(self.rank);
+        // Every 600 s of simulated time, at the first lookup past it: what each rank's G2 holds,
+        // how many distinct blocks the pool holds, and how many of them two or more ranks hold.
+        static NEXT_SNAPSHOT_MS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+        if let Some(now) = now
+            && now >= f64::from_bits(NEXT_SNAPSHOT_MS.load(std::sync::atomic::Ordering::Relaxed))
+        {
+            NEXT_SNAPSHOT_MS.store(
+                (now - now % 600_000.0 + 600_000.0).to_bits(),
+                std::sync::atomic::Ordering::Relaxed,
+            );
+            let mut held: FxHashMap<u64, u32> = FxHashMap::default();
+            let mut per_rank = vec![(self.rank.worker_id, own.resident_hashes())];
+            for (rank, g2) in &peers {
+                per_rank.push((rank.worker_id, g2.lock().resident_hashes()));
+            }
+            for (_, hashes) in &per_rank {
+                for hash in hashes {
+                    *held.entry(*hash).or_default() += 1;
+                }
+            }
+            let sizes: Vec<String> = per_rank.iter().map(|(w, h)| format!("[{w},{}]", h.len())).collect();
+            crate::engine::kvcr::probe::write(&format!(
+                r#"{{"ev":"g2snap","t":{now:.3},"capacity":{},"per_rank":[{}],"unique":{},"multi":{}}}"#,
+                own.capacity_blocks(),
+                sizes.join(","),
+                held.len(),
+                held.values().filter(|n| **n >= 2).count(),
+            ));
+        }
+        let (mut best, mut best_worker, mut named) = (0usize, None, None);
+        for (rank, g2) in peers {
+            let held = lead(&g2.lock());
+            if held > best {
+                (best, best_worker) = (held, Some(rank.worker_id));
+            }
+            if Some(rank) == hint {
+                named = Some(held);
+            }
+        }
+        let opt = |v: Option<String>| v.unwrap_or_else(|| "null".into());
+        crate::engine::kvcr::probe::write(&format!(
+            r#"{{"ev":"{event}","uuid":"{owner}","w":{},"t":{},"keys":{},"g1":{},"own":{own_blocks},"best":{best},"best_w":{},"named":{},"named_w":{}}}"#,
+            self.rank.worker_id,
+            opt(now.map(|t| format!("{t:.3}"))),
+            keys.len(),
+            opt(g1_blocks.map(|n| n.to_string())),
+            opt(best_worker.map(|w| w.to_string())),
+            opt(named.map(|n| n.to_string())),
+            opt(hint.map(|h| h.worker_id.to_string())),
+        ));
+    }
+
