diff --git a/crates/core/src/engine/scheduler/vllm/kvcr.rs b/crates/core/src/engine/scheduler/vllm/kvcr.rs
index e42c8e4b0..ad69b0d01 100644
--- a/crates/core/src/engine/scheduler/vllm/kvcr.rs
+++ b/crates/core/src/engine/scheduler/vllm/kvcr.rs
@@ -66,6 +66,78 @@ impl VllmKvcrAdapter {
         self.rank
