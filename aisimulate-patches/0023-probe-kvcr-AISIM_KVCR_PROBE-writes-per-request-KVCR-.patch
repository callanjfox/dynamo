+/// Per-request KVCR probe (diagnostics only): with `AISIM_KVCR_PROBE=<path>` set, ranks append one
+/// JSON line per event (request arrival, first G2 lookup, each staged pull) to that file. Unset, it
+/// does nothing and costs one environment read.
+pub(crate) mod probe {
+    use std::io::Write;
+    use std::sync::{Mutex, OnceLock};
+
+    static OUT: OnceLock<Option<Mutex<std::io::LineWriter<std::fs::File>>>> = OnceLock::new();
+
+    fn out() -> &'static Option<Mutex<std::io::LineWriter<std::fs::File>>> {
+        OUT.get_or_init(|| {
+            std::env::var_os("AISIM_KVCR_PROBE")
+                .and_then(|path| std::fs::File::create(path).ok())
+                .map(|file| Mutex::new(std::io::LineWriter::new(file)))
+        })
+    }
+
+    pub(crate) fn enabled() -> bool {
+        out().is_some()
+    }
+
+    pub(crate) fn write(line: &str) {
+        if let Some(out) = out() {
+            let _ = writeln!(out.lock().unwrap(), "{line}");
+        }
+    }
+}
