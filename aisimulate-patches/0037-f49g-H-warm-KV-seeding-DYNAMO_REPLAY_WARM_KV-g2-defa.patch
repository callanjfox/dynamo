+    /// Warm KV: just before a users primer reaches its worker, make its complete prompt blocks
+    /// resident in that worker's G2 (once per primer), so its admission loads them host to
+    /// device instead of prefilling them. The router sees the seeded blocks' stored events
+    /// before the primer is submitted.
+    fn seed_warm_kv(
+        &mut self,
+        request: &DirectRequest,
+        uuid: Uuid,
+        worker_idx: usize,
+    ) -> anyhow::Result<()> {
+        if self.warm_kv == WarmKv::Off || !is_primer(request) || !self.warm_kv_seeds.claim(uuid) {
+            return Ok(());
+        }
+        let session_id = request
+            .replay_context
+            .as_ref()
+            .and_then(|context| context.session_id().map(str::to_owned));
+        let effects = self.engine.apply_command(
+            worker_idx,
+            Command::KvBlocks(KvBlockCommand::Seed {
+                owner: uuid,
+                tokens: request.tokens.clone(),
+                session_id,
+            }),
+            self.now_ms,
+        )?;
+        let seeded = effects.result == CommandResult::Applied;
+        self.warm_kv_seeds.record(worker_idx, request.tokens.len(), seeded);
+        tracing::debug!(%uuid, worker_idx, seeded, "warm KV: primer seed");
+        self.apply_engine_observations(effects.engine_events, KvIngestBoundary::SchedulerCommand)?;
+        // A seed into a cluster-shared G2 wakes the pool's other ranks: settle them before the
+        // primer's own submit, which the engine refuses while internal work is due.
+        let mut steps = 0usize;
+        self.settle_internal_work(&mut steps)?;
+        Ok(())
+    }
