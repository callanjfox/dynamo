+    /// Warm KV (`KvBlockCommand::Seed`): make `request`'s complete prompt blocks resident in
+    /// this rank's G2 at once, as if an earlier turn of its session had offloaded them. The
+    /// blocks take the request's own host keys and router identities, enter as the newest
+    /// blocks of the LRU, evict the least recently used unpinned blocks as a store would (never
+    /// a block of this prompt), take no D2H time, and are published as `HostPinned` stored
+    /// events. Blocks G2 already holds or is still writing stay as they are. Seeding stops at
+    /// the first block G2 has no room for. Returns the seeded blocks in prompt order.
+    pub(super) fn seed_prefix(
+        &mut self,
+        request: &VllmHostRequestState,
+        kv_manager: &mut G1Manager,
+        now_ms: f64,
+    ) -> Vec<HostBlockKey> {
+        if request.prompt_keys.is_empty() {
+            return Vec::new();
+        }
+        let client = self.host.id();
+        let mut tier = self.host.lock();
+        // With a pass in flight, host completions due before `now_ms` stay unticked until the
+        // pass boundary, and the tier refuses a mutation past an unticked completion. The seed
+        // then lands at the earliest such completion instead. Without a pass in flight nothing
+        // is due (the engine refuses a command while internal work is due), so it lands at
+        // `now_ms`.
+        let at_ms = tier
+            .next_deadline(client)
+            .map_or(now_ms, |deadline| deadline.min(now_ms))
+            .max(tier.current_time_ms());
+        let mut plan = tier.plan_external(&request.prompt_keys, at_ms);
+        let mut seen = rustc_hash::FxHashSet::default();
+        let mut seeded = Vec::new();
+        let mut seeded_meta = Vec::new();
+        for (index, key) in request.prompt_keys.iter().copied().enumerate() {
+            if !seen.insert(key) || tier.planned_lookup(Some(&plan), key) != Lookup::Miss {
+                continue;
+            }
+            if !tier.plan_reserve(&mut plan, key) {
+                break;
+            }
+            seeded.push(key);
+            if let Some(meta) = &request.prompt_meta {
+                seeded_meta.push(meta[index].clone());
+            }
+        }
+        if seeded.is_empty() {
+            return seeded;
+        }
+        let meta = request.prompt_meta.is_some().then_some(seeded_meta);
+        let transfer_id = tier.reserve_planned(client, request.owner, plan, meta, at_ms);
+        tier.complete_external(transfer_id);
+        // vLLM's lookup touches a prompt's blocks in reverse, so the earlier turn that left this
+        // prefix in G2 left its head the newest: under pressure the tail goes first.
+        for key in seeded.iter().rev() {
+            tier.touch(*key);
+        }
+        // The seed is a command: the residency it publishes belongs to the command's KV events.
+        for event in tier.take_events(client) {
+            kv_manager.publish_host_pinned_event(event);
+        }
+        seeded
+    }
+
