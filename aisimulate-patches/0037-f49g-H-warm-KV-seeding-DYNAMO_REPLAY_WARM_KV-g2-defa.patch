+    /// A prefix-caching core with a private G2 of `g2_blocks` that captures its KV events, so
+    /// G2 publishes its residency as `HostPinned` events.
+    fn warm_core(g2_blocks: usize) -> VllmCore {
+        let args = MockEngineArgs::builder()
+            .num_gpu_blocks(16)
+            .block_size(4)
+            .max_num_seqs(Some(4))
+            .max_num_batched_tokens(Some(64))
+            .enable_prefix_caching(true)
+            .kv_cache_bytes_per_token(Some(250_000))
+            .native_host_offload(Some(
+                NativeHostOffloadConfig::new(g2_blocks).with_bandwidths(1.0, 1.0),
+            ))
+            .speedup_ratio(0.0)
+            .build()
+            .unwrap();
+        VllmCore::new_with_worker_rank(args, 0, 0, 0, true, None).unwrap()
+    }
+
+    fn warm_seed(owner: Uuid, tokens: &[u32]) -> SchedulerCommand {
+        SchedulerCommand::KvBlocks(crate::engine::KvBlockCommand::Seed {
+            owner,
+            tokens: tokens.to_vec(),
+            session_id: None,
+        })
+    }
+
+    /// The `HostPinned` residency changes in `events`.
+    fn host_residency(events: &[crate::engine::KvEvent]) -> Vec<(&'static str, Vec<u64>)> {
+        use crate::engine::{KvEventData, KvEventTier};
+        events
+            .iter()
+            .filter(|event| event.tier == KvEventTier::HostPinned)
+            .map(|event| match &event.data {
+                KvEventData::Stored(stored) => (
+                    "stored",
+                    stored.blocks.iter().map(|block| block.block_hash).collect(),
+                ),
+                KvEventData::Removed { block_hashes } => ("removed", block_hashes.clone()),
+            })
+            .collect()
+    }
+
+    /// Serve one request to completion; returns each admission's host-reused prompt tokens.
+    fn serve(core: &mut VllmCore, uuid: Uuid, tokens: Vec<u32>, now_ms: &mut f64) -> Vec<usize> {
+        core.receive(DirectRequest {
+            tokens,
+            max_output_tokens: 1,
+            uuid: Some(uuid),
+            arrival_timestamp_ms: Some(*now_ms),
+            ..Default::default()
+        });
+        let mut host_reused = Vec::new();
+        for _ in 0..16 {
+            if core.is_ready() {
+                let pass = core.execute_pass(&mut TraceCollector::default(), *now_ms);
+                *now_ms = pass.end_ms;
+                core.complete_engine_boundary(*now_ms);
+                host_reused.extend(pass.admissions.iter().map(|admission| {
+                    admission
+                        .cache_tier_attribution
+                        .map_or(0, |tiers| tiers.host_reused_input_tokens)
+                }));
+            } else if let Some(deadline) = core.next_internal_deadline_ms() {
+                *now_ms = (*now_ms).max(deadline);
+                core.process_internal_work(*now_ms);
+            } else {
+                assert!(core.is_empty());
+                return host_reused;
+            }
+        }
+        panic!("request did not drain")
+    }
+
+    #[test]
+    fn warm_seed_makes_a_primer_prefix_host_resident_and_its_admission_loads_it() {
+        let mut core = warm_core(8);
+        let primer = Uuid::from_u128(60);
+        // Two complete blocks and one more token.
+        let tokens: Vec<u32> = (1..=9).collect();
+        let hashes = prompt_hashes(primer, tokens.clone());
+        assert_eq!(hashes.len(), 2);
+        assert_eq!(
+            core.apply_command(warm_seed(primer, &tokens)).unwrap(),
+            SchedulerCommandResult::Applied
+        );
+        assert!(hashes.iter().all(|hash| core.kv_residency(*hash) == (false, true)));
+        // The router learns of the seeded blocks as of any G2 store.
+        let events = core.drain_kv_events();
+        assert_eq!(host_residency(&events), vec![("stored", hashes.clone())]);
+        assert_eq!(events.len(), 1, "a seed publishes no device events");
+
+        let mut now_ms = 0.0;
+        assert_eq!(
+            serve(&mut core, primer, tokens, &mut now_ms),
+            vec![8],
+            "the primer loads both blocks host to device instead of prefilling them"
+        );
+        assert!(hashes.iter().all(|hash| core.kv_residency(*hash) == (true, true)));
+    }
+
+    #[test]
+    fn warm_seed_evicts_the_least_recently_used_host_blocks_when_g2_is_full() {
+        // A G2 of four blocks; each prompt has two.
+        let mut core = warm_core(4);
+        let ids: Vec<Uuid> = (61..=64).map(Uuid::from_u128).collect();
+        let prompts: Vec<Vec<u32>> = [1u32, 101, 201, 301]
+            .iter()
+            .map(|first| (*first..*first + 8).collect())
+            .collect();
+        let hashes: Vec<Vec<u64>> = ids
+            .iter()
+            .zip(&prompts)
+            .map(|(id, prompt)| prompt_hashes(*id, prompt.clone()))
+            .collect();
+        let in_g2 = |core: &VllmCore, hashes: &[u64]| {
+            hashes
+                .iter()
+                .map(|hash| core.kv_residency(*hash).1)
+                .collect::<Vec<_>>()
+        };
+        for (id, prompt) in ids.iter().zip(&prompts).take(2) {
+            assert_eq!(
+                core.apply_command(warm_seed(*id, prompt)).unwrap(),
+                SchedulerCommandResult::Applied
+            );
+        }
+        core.drain_kv_events();
+
+        // G2 is full: C's seed evicts A, the older seed, and keeps B.
+        assert_eq!(
+            core.apply_command(warm_seed(ids[2], &prompts[2])).unwrap(),
+            SchedulerCommandResult::Applied
+        );
+        assert_eq!(in_g2(&core, &hashes[0]), vec![false, false]);
+        assert_eq!(in_g2(&core, &hashes[1]), vec![true, true]);
+        assert_eq!(in_g2(&core, &hashes[2]), vec![true, true]);
+        let events = host_residency(&core.drain_kv_events());
+        assert_eq!(events.len(), 2, "{events:?}");
+        assert_eq!(events[0].0, "removed");
+        let mut removed = events[0].1.clone();
+        removed.sort_unstable();
+        let mut a = hashes[0].clone();
+        a.sort_unstable();
+        assert_eq!(removed, a);
+        assert_eq!(events[1], ("stored", hashes[2].clone()));
+
+        // C entered as the newest: D's seed evicts B, not C.
+        assert_eq!(
+            core.apply_command(warm_seed(ids[3], &prompts[3])).unwrap(),
+            SchedulerCommandResult::Applied
+        );
+        assert_eq!(in_g2(&core, &hashes[1]), vec![false, false]);
+        assert_eq!(in_g2(&core, &hashes[2]), vec![true, true]);
+        assert_eq!(in_g2(&core, &hashes[3]), vec![true, true]);
+    }
+
+    #[test]
+    fn warm_seed_keeps_blocks_g2_holds_and_stops_where_g2_has_no_room() {
+        // A G2 of two blocks and a prompt of three.
+        let mut core = warm_core(2);
+        let owner = Uuid::from_u128(65);
+        let tokens: Vec<u32> = (1..=12).collect();
+        let hashes = prompt_hashes(owner, tokens.clone());
+        assert_eq!(
+            core.apply_command(warm_seed(owner, &tokens)).unwrap(),
+            SchedulerCommandResult::Applied
+        );
+        assert_eq!(
+            hashes
+                .iter()
+                .map(|hash| core.kv_residency(*hash).1)
+                .collect::<Vec<_>>(),
+            vec![true, true, false],
+            "the leading blocks that fit, never evicting the prompt's own"
+        );
+        core.drain_kv_events();
+        // Seeding the same prompt again changes nothing and publishes nothing.
+        assert_eq!(
+            core.apply_command(warm_seed(owner, &tokens)).unwrap(),
+            SchedulerCommandResult::Noop
+        );
+        assert!(host_residency(&core.drain_kv_events()).is_empty());
+    }
+
+    #[test]
+    fn warm_seed_is_a_noop_without_g2() {
+        let args = MockEngineArgs::builder()
+            .num_gpu_blocks(16)
+            .block_size(4)
+            .enable_prefix_caching(true)
+            .kv_cache_bytes_per_token(Some(250_000))
+            .speedup_ratio(0.0)
+            .build()
+            .unwrap();
+        let mut core = VllmCore::new(args);
+        let tokens: Vec<u32> = (1..=8).collect();
+        assert_eq!(
+            core.apply_command(warm_seed(Uuid::from_u128(66), &tokens)).unwrap(),
+            SchedulerCommandResult::Noop
+        );
+    }
 }
