+    /// `KvBlockCommand::Seed`: make the complete prompt blocks of `tokens` resident in this
+    /// rank's G2 under the host keys and router identities that request `owner` will look them
+    /// up by (see `VllmHostOffloadAdapter::seed_prefix`). Returns the seeded blocks' hashes.
+    fn seed_host_prefix(
+        &mut self,
+        owner: Uuid,
+        tokens: Vec<u32>,
+        session_id: Option<String>,
+        now_ms: f64,
+    ) -> Vec<u64> {
+        let Some(adapter) = self.native_host_offload.as_mut() else {
+            return Vec::new();
+        };
+        let block_size = self.args.block_size;
+        // The same identities `make_request_state` gives the request itself.
+        let mut state = RequestKvState::native(
+            owner,
+            tokens,
+            1,
+            1,
+            block_size,
+            self.args.enable_prefix_caching,
+            self.retain_local_hashes,
+            self.emit_token_ids,
+            None,
+        );
+        state.lease.session_id = session_id;
+        let request = VllmHostRequestState::new(
+            &state.sequence,
+            &state.lease,
+            block_size,
+            adapter.publishes_residency(),
+            None,
+        );
+        let seeded = adapter.seed_prefix(&request, &mut self.kv_manager, now_ms);
+        tracing::debug!(
+            %owner,
+            prompt_blocks = state.sequence.num_input_tokens() / block_size,
+            seeded_blocks = seeded.len(),
+            "warm KV: seeded a primer's prefix into G2"
+        );
+        seeded.into_iter().map(|key| key.sequence_hash()).collect()
+    }
