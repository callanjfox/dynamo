         local_hashes: &[crate::engine::common::hashing::BlockHash],
-        parent: Option<u64>,
+        ancestors: &[u64],
     ) -> Vec<u64> {
-        self.inner.prefetch_cached_blocks(hashes, local_hashes, parent)
+        self.inner.prefetch_cached_blocks(hashes, local_hashes, ancestors)
     }
 
     pub(crate) fn take_retain_broken(&mut self) -> u64 {
