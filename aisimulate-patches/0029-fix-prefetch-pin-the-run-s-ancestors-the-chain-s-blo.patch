         self.pool.has_cached(hash)
     }
 
-    /// Path B prefetch: put `hashes` (a run of one prefix chain after `parent`) into G1 as
-    /// idle cached blocks, evicting ordinary LRU blocks for room, and publish them as stored.
-    /// Returns the blocks loaded; none when there is no room.
+    /// Path B prefetch: put `hashes` (a run of one prefix chain after `ancestors`, the chain's
+    /// blocks before the run, root first) into G1 as idle cached blocks, evicting ordinary LRU
+    /// blocks for room, and publish them as stored. Returns the blocks loaded; none when there is
+    /// no room or G1 lacks an ancestor.
     pub(crate) fn prefetch_cached_blocks(
         &mut self,
         hashes: &[SequenceHash],
         local_hashes: &[BlockHash],
-        parent: Option<SequenceHash>,
+        ancestors: &[SequenceHash],
     ) -> Vec<SequenceHash> {
-        if hashes.is_empty() {
+        if hashes.is_empty() || !ancestors.iter().all(|hash| self.pool.has_cached(*hash)) {
             return Vec::new();
         }
-        let Some(mut outcome) = self.pool.reserve(&[], hashes.len()) else {
+        let parent = ancestors.last().copied();
+        // The ancestors are pinned while room is made, so it never comes from evicting them, and
+        // released after the run, tail first, as a request's prefix hit does: the chain stays
+        // ordered for eviction from its tail. Unpinned, an ancestor kept its old recency, was
+        // evicted before the run below it, and the router's indexer truncated the chain there
+        // (kitchen sink v1 stopped: "failed to apply replay KV event ... Failed to find block").
+        let Some(mut outcome) = self.pool.reserve(ancestors, hashes.len()) else {
             return Vec::new();
         };
         self.publish_removed(std::mem::take(&mut outcome.removed));
-        // The room may have come from evicting the run's parent (an idle cached block). A run
-        // published under a parent the router's indexer no longer holds cannot attach there, and
-        // its later removals name blocks the indexer never stored: load nothing then.
-        if parent.is_some_and(|parent| !self.pool.has_cached(parent)) {
-            self.pool.cancel(outcome.reservation);
-            return Vec::new();
-        }
         // The room may be capacity a pending transfer still reads (a G2 store of the blocks
         // evicted for it). A prefetch loads at once and cannot wait behind that transfer, as a
         // request's load does (`native_destination_pending_dependencies`): load nothing then.
@@ -1848,6 +1848,24 @@ impl VllmKvManager {
                 }
             } else {
