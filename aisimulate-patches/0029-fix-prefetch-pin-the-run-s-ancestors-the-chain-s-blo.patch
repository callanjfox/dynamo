+    #[test]
+    fn a_prefetch_refreshes_the_run_s_ancestors_so_eviction_never_cuts_the_chain() {
+        // G1 of four blocks. A's last two blocks are demoted; B then makes A's head the oldest
+        // idle block. Prefetching A's run must leave its head newer than the run: a later prompt
+        // evicts B first, never A's head with A's run still below it (the router's indexer
+        // truncated the chain there; kitchen sink v1 stopped on "Failed to find block").
+        let mut core = block_action_core(4, 8, false);
+        let mut now_ms = 0.0;
+        let tokens: Vec<u32> = (1..=12).collect();
+        let a = Uuid::from_u128(52);
+        run_to_completion(&mut core, a, tokens.clone(), &mut now_ms);
+        let hashes = prompt_hashes(a, tokens);
+        core.apply_command(drop_blocks(&hashes[1..], true, false, true)).unwrap();
+        assert_eq!(core.kv_residency(hashes[0]), (true, true));
+        assert!(hashes[1..].iter().all(|hash| core.kv_residency(*hash) == (false, true)));
+        let b_tokens: Vec<u32> = (31..=34).collect();
+        let b = Uuid::from_u128(53);
+        run_to_completion(&mut core, b, b_tokens.clone(), &mut now_ms);
+        core.apply_command(prefetch_blocks(&hashes)).unwrap();
+        assert!(hashes.iter().all(|hash| core.kv_residency(*hash).0), "the run loaded");
+        run_to_completion(&mut core, Uuid::from_u128(54), (41..=44).collect(), &mut now_ms);
+        let in_g1: Vec<bool> = hashes.iter().map(|hash| core.kv_residency(*hash).0).collect();
+        assert!(in_g1[0], "A's head outlives the run below it: {in_g1:?}");
+        assert!(!core.kv_residency(prompt_hashes(b, b_tokens)[0]).0, "B went first");
+    }
+
